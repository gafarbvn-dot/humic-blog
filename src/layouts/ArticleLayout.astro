---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CanonicalAnswer from '../components/CanonicalAnswer.astro';
import type { CitationItem, FaqItem } from '../components/SchemaMarkup.astro';

export interface Props {
  title: string;
  description: string;
  canonicalAnswer: string;
  pillar: string;
  isPillarPage?: boolean;
  pubDate: Date;
  updatedDate?: Date;
  slug: string;
  headings: MarkdownHeading[];
  faqs: FaqItem[];
  citations: CitationItem[];
  readingMinutes: number;
}

const {
  title,
  description,
  canonicalAnswer,
  pillar,
  isPillarPage = false,
  pubDate,
  updatedDate,
  slug,
  headings,
  faqs,
  citations,
  readingMinutes,
} = Astro.props;

const canonicalPath = `/${slug}`;
const siteUrl = 'https://humic.blog';

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: pillar, url: `${siteUrl}/#encyclopedia` },
  { name: title, url: `${siteUrl}${canonicalPath}` },
];

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schemaType="article"
  pillar={pillar}
  pubDate={pubDate}
  updatedDate={updatedDate}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  citations={citations}
>
  <!-- Article Header Band -->
  <div class="bg-emerald-950 text-white border-b border-emerald-900">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs font-medium text-emerald-300 flex flex-wrap items-center gap-1.5">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#encyclopedia" class="hover:text-amber-400 transition-colors">{pillar}</a>
        <span aria-hidden="true">/</span>
        <span class="text-emerald-100 truncate max-w-xs sm:max-w-md">{title}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2.5 mb-3">
        <span class="inline-flex items-center rounded-full bg-emerald-900 border border-emerald-700/80 px-3 py-0.5 text-xs font-semibold text-emerald-100">
          {pillar}
        </span>
        {isPillarPage && (
          <span class="inline-flex items-center rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-0.5 text-xs font-semibold text-amber-300">
            Cornerstone Guide
          </span>
        )}
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-[2.65rem] font-bold tracking-tight text-white leading-tight max-w-4xl">
        {title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm text-emerald-200/90">
        <span>Published: <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
        {updatedDate && (
          <span>Updated: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
        )}
        <span>{readingMinutes} min read</span>
        <span>Peer-Reviewed &amp; Vendor-Neutral</span>
      </div>
    </div>
  </div>

  <!-- Body + Sticky TOC -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_285px] gap-10 items-start">
      <!-- Main Reading Column -->
      <article class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 sm:p-10">
        <!-- GEO Canonical Answer directly under H1 context -->
        <CanonicalAnswer answer={canonicalAnswer} />

        <!-- Mobile TOC -->
        {tocHeadings.length > 0 && (
          <details class="lg:hidden mb-8 rounded-xl border border-slate-200 bg-slate-50 p-4">
            <summary class="cursor-pointer text-sm font-bold text-emerald-950 select-none">
              Table of Contents
            </summary>
            <ul class="mt-3 space-y-1.5 text-sm border-l-2 border-emerald-900/20 pl-3">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? 'pl-3 text-slate-600' : 'font-medium text-slate-800'}>
                  <a href={`#${h.slug}`} class="hover:text-emerald-800 transition-colors">
                    {h.text}
                  </a>
                </li>
              ))}
              <li class="font-medium text-slate-800">
                <a href="#frequently-asked-questions" class="hover:text-emerald-800 transition-colors">
                  Frequently Asked Questions
                </a>
              </li>
              <li class="font-medium text-slate-800">
                <a href="#scientific-references" class="hover:text-emerald-800 transition-colors">
                  Scientific References
                </a>
              </li>
            </ul>
          </details>
        )}

        <!-- MDX Content -->
        <div class="prose prose-slate max-w-none prose-headings:font-serif prose-headings:text-emerald-950 prose-strong:text-slate-900">
          <slot />
        </div>

        <!-- Structured FAQs (aligned with FAQPage JSON-LD) -->
        {faqs.length > 0 && (
          <section id="frequently-asked-questions" class="mt-12 pt-8 border-t border-slate-200 scroll-mt-24">
            <div class="flex items-center gap-2 mb-5">
              <span class="h-5 w-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
              <h2 class="font-serif text-2xl font-bold text-emerald-950 m-0">
                Frequently Asked Questions
              </h2>
            </div>
            <div class="space-y-4">
              {faqs.map((faq) => (
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-5">
                  <h3 class="font-serif text-lg font-bold text-emerald-950 mb-2">
                    {faq.question}
                  </h3>
                  <p class="text-sm sm:text-[0.96rem] leading-relaxed text-slate-700 m-0">
                    {faq.answer}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Scientific References Block -->
        {citations.length > 0 && (
          <section id="scientific-references" class="mt-12 pt-8 border-t border-slate-200 scroll-mt-24">
            <div class="flex items-center gap-2 mb-4">
              <span class="h-5 w-1.5 rounded-full bg-emerald-900" aria-hidden="true"></span>
              <h2 class="font-serif text-2xl font-bold text-emerald-950 m-0">
                Scientific References &amp; Standards
              </h2>
            </div>
            <ol class="space-y-3 pl-5 list-decimal text-sm text-slate-700 leading-relaxed">
              {citations.map((cite) => (
                <li class="pl-1">
                  <span class="font-semibold text-slate-900">{cite.title}.</span>{' '}
                  <span class="italic text-slate-700">{cite.source}.</span>{' '}
                  {cite.url && (
                    <a
                      href={cite.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-emerald-800 underline decoration-amber-500 underline-offset-2 hover:text-emerald-950 break-all"
                    >
                      Source / DOI ↗
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )}
      </article>

      <!-- Sticky Right Sidebar -->
      <aside class="hidden lg:block lg:sticky lg:top-24 space-y-6">
        {tocHeadings.length > 0 && (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
            <h2 class="font-sans text-xs font-bold uppercase tracking-wider text-emerald-900 mb-3">
              On This Page
            </h2>
            <nav aria-label="Table of Contents">
              <ul id="desktop-toc" class="space-y-2 text-[0.84rem] border-l-2 border-slate-200 pl-3.5">
                {tocHeadings.map((h) => (
                  <li class={h.depth === 3 ? 'pl-3' : ''}>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link={h.slug}
                      class:list={[
                        'block leading-snug transition-colors hover:text-emerald-900',
                        h.depth === 3 ? 'text-slate-500' : 'font-medium text-slate-700',
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
                <li>
                  <a
                    href="#frequently-asked-questions"
                    data-toc-link="frequently-asked-questions"
                    class="block leading-snug font-medium text-slate-700 hover:text-emerald-900 transition-colors"
                  >
                    Frequently Asked Questions
                  </a>
                </li>
                <li>
                  <a
                    href="#scientific-references"
                    data-toc-link="scientific-references"
                    class="block leading-snug font-medium text-slate-700 hover:text-emerald-900 transition-colors"
                  >
                    Scientific References
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        )}

        <!-- Quick Field Tools Widget -->
        <div class="rounded-2xl border border-emerald-900/15 bg-emerald-950 text-white p-5 shadow-xs">
          <div class="text-[11px] font-bold uppercase tracking-wider text-amber-400 mb-1.5">
            Interactive Field Tools
          </div>
          <p class="text-xs text-emerald-200 leading-relaxed mb-4">
            Apply humic science accurately with zero-dependency agronomic calculators and standardized reference tools.
          </p>
          <div class="space-y-2">
            <a
              href="/tools/dosage-calculator"
              class="block rounded-lg bg-emerald-900 hover:bg-emerald-800 px-3.5 py-2.5 text-xs font-semibold text-white border border-emerald-800 transition-colors"
            >
              Dosage Calculator &rarr;
            </a>
            <a
              href="/tools/tank-mix-checker"
              class="block rounded-lg bg-emerald-900 hover:bg-emerald-800 px-3.5 py-2.5 text-xs font-semibold text-white border border-emerald-800 transition-colors"
            >
              Tank-Mix Checker &rarr;
            </a>
            <a
              href="/glossary"
              class="block rounded-lg bg-amber-500 hover:bg-amber-400 px-3.5 py-2.5 text-xs font-bold text-emerald-950 transition-colors"
            >
              A–Z Humic Glossary &rarr;
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      const links = Array.from(document.querySelectorAll('#desktop-toc [data-toc-link]'));
      if (!links.length || !('IntersectionObserver' in window)) return;
      const map = new Map();
      links.forEach((a) => {
        const id = a.getAttribute('data-toc-link');
        const el = id ? document.getElementById(id) : null;
        if (el) map.set(el, a);
      });
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              links.forEach((l) => {
                l.classList.remove('text-emerald-900', 'font-bold');
              });
              const active = map.get(entry.target);
              if (active) {
                active.classList.add('text-emerald-900', 'font-bold');
              }
            }
          });
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );
      map.forEach((_, el) => observer.observe(el));
    })();
  </script>
</BaseLayout>
