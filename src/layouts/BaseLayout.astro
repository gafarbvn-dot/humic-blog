---
import '../styles/global.css';
import SchemaMarkup, {
  type BreadcrumbItem,
  type CitationItem,
  type FaqItem,
} from '../components/SchemaMarkup.astro';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  schemaType?: 'website' | 'article' | 'tool' | 'glossary';
  pillar?: string;
  pubDate?: Date;
  updatedDate?: Date;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FaqItem[];
  citations?: CitationItem[];
  extraSchemaNodes?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath,
  schemaType = 'website',
  pillar,
  pubDate,
  updatedDate,
  breadcrumbs = [],
  faqs = [],
  citations = [],
  extraSchemaNodes = [],
} = Astro.props;

const siteOrigin = 'https://humic.blog';
const rawPath = canonicalPath ?? Astro.url.pathname;
const normalizedPath = rawPath === '/' ? '' : rawPath.replace(/\/+$/, '');
const canonicalUrl = normalizedPath ? `${siteOrigin}${normalizedPath}` : siteOrigin;
const fullTitle = title.includes('Humic.blog') ? title : `${title} | Humic.blog`;

const navLinks = [
  { href: '/#encyclopedia', label: 'Encyclopedia' },
  { href: '/tools/dosage-calculator', label: 'Dosage Calculator' },
  { href: '/tools/tank-mix-checker', label: 'Tank-Mix Checker' },
  { href: '/glossary', label: 'A–Z Glossary' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={schemaType === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Humic.blog" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {(updatedDate || pubDate) && schemaType === 'article' && (
      <meta property="article:modified_time" content={(updatedDate ?? pubDate)!.toISOString()} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Structured Data (@graph JSON-LD) -->
    <SchemaMarkup
      type={schemaType}
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      pillar={pillar}
      pubDate={pubDate}
      updatedDate={updatedDate}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      citations={citations}
      extraNodes={extraSchemaNodes}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 antialiased selection:bg-amber-200 selection:text-emerald-950">
    <!-- Top Header -->
    <header class="sticky top-0 z-40 bg-emerald-950 text-white border-b border-emerald-900/80 shadow-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
            <img src="/favicon.svg" alt="" width="30" height="30" class="rounded-md" />
            <div class="flex flex-col leading-none">
              <span class="font-serif text-lg font-bold tracking-tight text-white group-hover:text-amber-400 transition-colors">
                Humic<span class="text-amber-500">.blog</span>
              </span>
              <span class="text-[10px] font-medium tracking-widest uppercase text-emerald-300/90 mt-0.5">
                Soil Science Encyclopedia
              </span>
            </div>
          </a>

          <!-- Desktop Nav -->
          <nav aria-label="Primary Navigation" class="hidden md:flex items-center gap-1">
            {navLinks.map((item) => {
              const isActive =
                item.href !== '/#encyclopedia' &&
                normalizedPath === item.href;
              return (
                <a
                  href={item.href}
                  class:list={[
                    'px-3.5 py-2 rounded-lg text-sm font-medium transition-colors',
                    isActive
                      ? 'bg-emerald-900 text-amber-400'
                      : 'text-emerald-100 hover:bg-emerald-900/70 hover:text-white',
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>

          <!-- Mobile Toggle -->
          <button
            id="mobile-nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-nav-menu"
            aria-label="Toggle navigation menu"
            class="md:hidden inline-flex items-center justify-center rounded-lg p-2 text-emerald-100 hover:bg-emerald-900 hover:text-white focus:outline-none focus:ring-2 focus:ring-amber-500"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <nav
        id="mobile-nav-menu"
        aria-label="Mobile Navigation"
        class="hidden md:hidden border-t border-emerald-900 bg-emerald-950 px-4 py-3 space-y-1"
      >
        {navLinks.map((item) => (
          <a
            href={item.href}
            class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-emerald-950 text-emerald-100 border-t-4 border-amber-500 mt-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-10 border-b border-emerald-900">
          <div class="md:col-span-5 space-y-3">
            <a href="/" class="inline-flex items-center gap-2 font-serif text-xl font-bold text-white">
              Humic<span class="text-amber-500">.blog</span>
            </a>
            <p class="text-sm text-emerald-200/90 leading-relaxed max-w-md">
              An independent, vendor-neutral educational encyclopedia synthesizing peer-reviewed soil chemistry, IHSS and ISO 19822 analytical protocols, and global agronomic standards for humic and fulvic substances.
            </p>
            <p class="text-xs text-emerald-300/80 leading-relaxed max-w-md">
              Editorial Policy: Humic.blog accepts no product sponsorships and makes no pesticidal, fungicidal, or medicinal claims. Content focuses strictly on soil conditioning, nutrient use efficiency, and abiotic stress physiology.
            </p>
          </div>

          <div class="md:col-span-4 space-y-2.5">
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-amber-400">
              Cornerstone Guides
            </h3>
            <ul class="space-y-1.5 text-sm">
              <li><a href="/origins/formation-and-shocking-facts" class="hover:text-amber-400 transition-colors">Formation &amp; Soil Science Facts</a></li>
              <li><a href="/raw-materials/raw-materials-and-extraction" class="hover:text-amber-400 transition-colors">Raw Materials &amp; Alkaline Extraction</a></li>
              <li><a href="/quality-and-testing/market-malpractices-and-testing" class="hover:text-amber-400 transition-colors">Market Malpractices &amp; ISO 19822 Testing</a></li>
              <li><a href="/agronomy/complete-application-and-tank-mix-guide" class="hover:text-amber-400 transition-colors">Application &amp; Tank-Mix Guide</a></li>
              <li><a href="/agronomy/crop-calendar-and-precautions" class="hover:text-amber-400 transition-colors">Crop Calendar &amp; Field Precautions</a></li>
              <li><a href="/synergies/humic-seaweed-amino-synergies" class="hover:text-amber-400 transition-colors">Humic, Seaweed &amp; L-Amino Synergies</a></li>
              <li><a href="/regulations/global-organic-laws-and-standards" class="hover:text-amber-400 transition-colors">Global Organic Laws &amp; Standards</a></li>
              <li><a href="/soil-and-sustainability/sustainability-biodiversity-food-security" class="hover:text-amber-400 transition-colors">Sustainability, Biodiversity &amp; Food Security</a></li>
            </ul>
          </div>

          <div class="md:col-span-3 space-y-2.5">
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-amber-400">
              Tools &amp; Machine Index
            </h3>
            <ul class="space-y-1.5 text-sm">
              <li><a href="/tools/dosage-calculator" class="hover:text-amber-400 transition-colors">Humate &amp; Fulvic Dosage Calculator</a></li>
              <li><a href="/tools/tank-mix-checker" class="hover:text-amber-400 transition-colors">Tank-Mix Compatibility Checker</a></li>
              <li><a href="/glossary" class="hover:text-amber-400 transition-colors">A–Z Humic Science Glossary</a></li>
              <li><a href="/llms.txt" class="hover:text-amber-400 transition-colors">AI / LLM Directory (llms.txt)</a></li>
              <li><a href="/sitemap-index.xml" class="hover:text-amber-400 transition-colors">XML Sitemap</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-emerald-300/80">
          <p>&copy; {new Date().getFullYear()} Humic.blog. Open Educational Soil Science Resource.</p>
          <p>Aligned with IHSS &amp; ISO 19822 Analytical Standards.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const btn = document.getElementById('mobile-nav-toggle');
        const menu = document.getElementById('mobile-nav-menu');
        if (!btn || !menu) return;
        btn.addEventListener('click', function () {
          const isOpen = !menu.classList.contains('hidden');
          menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!isOpen));
        });
      })();
    </script>
  </body>
</html>
