---
import '../styles/global.css';
import SchemaMarkup, {
  type BreadcrumbItem,
  type CitationItem,
  type FaqItem,
  type HowToData,
} from '../components/SchemaMarkup.astro';

export type SupportedLocale = 'en' | 'hi' | 'gu' | 'ar' | 'es' | 'id';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  lang?: SupportedLocale;
  alternateUrls?: {
    en?: string;
    hi?: string;
    gu?: string;
    ar?: string;
    es?: string;
    id?: string;
    xDefault?: string;
  };
  ogImage?: string;
  schemaType?: 'website' | 'article' | 'tool' | 'glossary' | 'collection' | 'about';
  pillar?: string;
  pubDate?: Date;
  updatedDate?: Date;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FaqItem[];
  citations?: CitationItem[];
  howTo?: HowToData;
  extraSchemaNodes?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  lang = 'en',
  alternateUrls,
  ogImage,
  schemaType = 'website',
  pillar,
  pubDate,
  updatedDate,
  breadcrumbs = [],
  faqs = [],
  citations = [],
  howTo,
  extraSchemaNodes = [],
} = Astro.props;

const siteOrigin = 'https://humic.blog';
const rawPath = canonicalPath ?? Astro.url.pathname;
const normalizedPath = rawPath === '/' ? '' : rawPath.replace(/\/+$/, '');
const canonicalUrl = normalizedPath ? `${siteOrigin}${normalizedPath}` : siteOrigin;
const fullTitle = title.includes('Humic.blog') ? title : `${title} | Humic.blog`;
const resolvedOgImage = ogImage ?? `${siteOrigin}/og-default.svg`;
const dir = lang === 'ar' ? 'rtl' : 'ltr';

const navLinks =
  lang === 'hi'
    ? [
        { href: '/hi', label: 'हिन्दी हब' },
        { href: '/hi/humic-acid-kya-hai-aur-upyog', label: 'उपयोग व मात्रा' },
        { href: '/hi/asli-nakli-potassium-humate-ki-pehchan', label: '3-मिनट जांच' },
        { href: '/hi/ganne-ki-kheti-mein-humic-acid', label: 'गन्ना गाइड' },
        { href: '/tools/dosage-calculator', label: 'कैलकुलेटर' },
      ]
    : lang === 'gu'
      ? [
          { href: '/gu', label: 'ગુજરાતી હબ' },
          { href: '/gu/humic-acid-shu-che-ane-upyog', label: 'ઉપયોગ અને પ્રમાણ' },
          { href: '/gu/asli-nakli-potassium-humate-olakh', label: '3-મિનિટ ટેસ્ટ' },
          { href: '/gu/sherdi-ni-kheti-ma-humic-acid', label: 'શેરડી ગાઇડ' },
          { href: '/tools/dosage-calculator', label: 'કેલ્ક્યુલેટર' },
        ]
      : lang === 'ar'
        ? [
            { href: '/ar', label: 'المركز العربي' },
            { href: '/ar/humic-acid-saline-calcareous-soils', label: 'التربة المالحة والجيرية' },
            { href: '/ar/potassium-humate-vs-sodium-humate-guide', label: 'هيومات البوتاسيوم والصوديوم' },
            { href: '/tools/coa-verifier', label: 'فحص COA' },
          ]
        : lang === 'es'
          ? [
              { href: '/es', label: 'Hub Español' },
              { href: '/es/acido-humico-agricultura-fertirrigacion', label: 'Fertirrigación' },
              { href: '/es/humato-de-potasio-calidad-iso-19822', label: 'ISO 19822' },
              { href: '/tools/dosage-calculator', label: 'Calculadora' },
              { href: '/tools/coa-verifier', label: 'Verificar COA' },
            ]
          : lang === 'id'
            ? [
                { href: '/id', label: 'Hub Indonesia' },
                { href: '/id/asam-humat-tanah-masam-kelapa-sawit-padi', label: 'Tanah Masam' },
                { href: '/id/cara-membedakan-kalium-humat-asli-palsu', label: 'Tes Asli/Palsu' },
                { href: '/tools/dosage-calculator', label: 'Kalkulator' },
                { href: '/tools/coa-verifier', label: 'Cek COA' },
              ]
            : [
                { href: '/#encyclopedia', label: 'Pillars' },
                { href: '/crops', label: 'Crops' },
                { href: '/manufacturing', label: 'B2B' },
                { href: '/tools/dosage-calculator', label: 'Tools' },
                { href: '/field-sheets', label: 'Field Sheets' },
                { href: '/research-library', label: 'Research' },
                { href: '/glossary', label: 'Glossary' },
                { href: '/about', label: 'About' },
              ];

const toLocalHref = (url: string | undefined, fallback: string) =>
  url ? url.replace(siteOrigin, '') || '/' : fallback;

const localeOptions: Array<{ code: SupportedLocale; short: string; label: string; href: string }> = [
  { code: 'en', short: 'EN', label: 'English', href: toLocalHref(alternateUrls?.en, '/') },
  { code: 'hi', short: 'हिन्दी', label: 'हिन्दी (Hindi)', href: toLocalHref(alternateUrls?.hi, '/hi') },
  { code: 'gu', short: 'ગુજરાતી', label: 'ગુજરાતી (Gujarati)', href: toLocalHref(alternateUrls?.gu, '/gu') },
  { code: 'ar', short: 'العربية', label: 'العربية (Arabic)', href: toLocalHref(alternateUrls?.ar, '/ar') },
  { code: 'es', short: 'ES', label: 'Español (Spanish)', href: toLocalHref(alternateUrls?.es, '/es') },
  { code: 'id', short: 'ID', label: 'Bahasa Indonesia', href: toLocalHref(alternateUrls?.id, '/id') },
];

const currentLocale = localeOptions.find((l) => l.code === lang) ?? localeOptions[0];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Tag Manager (GTM-TD3Z82T6) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-TD3Z82T6');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrls?.en && <link rel="alternate" hreflang="en" href={alternateUrls.en} />}
    {alternateUrls?.hi && <link rel="alternate" hreflang="hi" href={alternateUrls.hi} />}
    {alternateUrls?.gu && <link rel="alternate" hreflang="gu" href={alternateUrls.gu} />}
    {alternateUrls?.ar && <link rel="alternate" hreflang="ar" href={alternateUrls.ar} />}
    {alternateUrls?.es && <link rel="alternate" hreflang="es" href={alternateUrls.es} />}
    {alternateUrls?.id && <link rel="alternate" hreflang="id" href={alternateUrls.id} />}
    {(alternateUrls?.xDefault || alternateUrls?.en) && (
      <link rel="alternate" hreflang="x-default" href={alternateUrls?.xDefault ?? alternateUrls?.en} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={schemaType === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Humic.blog" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {(updatedDate || pubDate) && schemaType === 'article' && (
      <meta property="article:modified_time" content={(updatedDate ?? pubDate)!.toISOString()} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured Data (@graph JSON-LD) -->
    <SchemaMarkup
      type={schemaType}
      lang={lang}
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      imageUrl={resolvedOgImage}
      pillar={pillar}
      pubDate={pubDate}
      updatedDate={updatedDate}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      citations={citations}
      howTo={howTo}
      extraNodes={extraSchemaNodes}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 antialiased selection:bg-amber-200 selection:text-emerald-950">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TD3Z82T6" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- Top Header -->
    <header class="sticky top-0 z-40 bg-emerald-950 text-white border-b border-emerald-900/80 shadow-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between gap-3">
          <a href={lang === 'en' ? '/' : `/${lang}`} class="flex items-center gap-2.5 group focus:outline-none shrink-0">
            <img src="/favicon.svg" alt="" width="30" height="30" class="rounded-md" />
            <div class="flex flex-col leading-none">
              <span class="font-serif text-lg font-bold tracking-tight text-white group-hover:text-amber-400 transition-colors">
                Humic<span class="text-amber-500">.blog</span>
              </span>
              <span class="text-[10px] font-medium tracking-widest uppercase text-emerald-300/90 mt-0.5">
                Soil Science Encyclopedia
              </span>
            </div>
          </a>

          <!-- Desktop Nav -->
          <nav aria-label="Primary Navigation" class="hidden md:flex items-center gap-1">
            {navLinks.map((item) => {
              const isActive =
                item.href !== '/#encyclopedia' &&
                (normalizedPath === item.href ||
                  (item.href.startsWith('/tools') && normalizedPath.startsWith('/tools')));
              return (
                <a
                  href={item.href}
                  class:list={[
                    'px-3 py-2 rounded-lg text-sm font-medium transition-colors whitespace-nowrap',
                    isActive
                      ? 'bg-emerald-900 text-amber-400'
                      : 'text-emerald-100 hover:bg-emerald-900/70 hover:text-white',
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>

          <!-- Compact 6-Language Dropdown + Search Trigger + Mobile Toggle -->
          <div class="flex items-center gap-2">
            <div class="relative" id="lang-dropdown-wrapper">
              <button
                id="lang-dropdown-btn"
                type="button"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="Select language"
                class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-900/90 hover:bg-emerald-800 border border-emerald-700/80 px-2.5 py-1.5 text-xs font-bold text-amber-300 transition-colors cursor-pointer"
              >
                <svg class="h-3.5 w-3.5 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zM3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18M12 3a15 15 0 000 18" />
                </svg>
                <span>{currentLocale.short}</span>
                <svg class="h-3 w-3 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <div
                id="lang-dropdown-menu"
                role="menu"
                class="hidden absolute end-0 mt-2 w-48 rounded-xl bg-white text-slate-900 border border-slate-200 shadow-xl py-1.5 z-50"
              >
                {localeOptions.map((opt) => (
                  <a
                    href={opt.href}
                    hreflang={opt.code}
                    role="menuitem"
                    class:list={[
                      'flex items-center justify-between px-3.5 py-2 text-xs font-semibold transition-colors',
                      opt.code === lang
                        ? 'bg-emerald-50 text-emerald-950 font-bold'
                        : 'text-slate-700 hover:bg-slate-100 hover:text-emerald-950',
                    ]}
                  >
                    <span>{opt.label}</span>
                    {opt.code === lang && (
                      <span class="inline-flex h-2 w-2 rounded-full bg-amber-500" aria-hidden="true"></span>
                    )}
                  </a>
                ))}
              </div>
            </div>

            <button
              id="open-search-btn"
              type="button"
              aria-label="Search encyclopedia"
              class="inline-flex items-center gap-2 rounded-lg bg-emerald-900/90 hover:bg-emerald-800 border border-emerald-700/80 px-2.5 sm:px-3 py-1.5 text-xs font-medium text-emerald-100 transition-colors cursor-pointer"
            >
              <svg class="h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 105.5 5.5a7.5 7.5 0 0011.15 11.15z" />
              </svg>
              <span class="hidden sm:inline">Search</span>
              <kbd class="hidden lg:inline-block rounded bg-emerald-950 px-1.5 py-0.5 text-[10px] font-mono text-emerald-300 border border-emerald-800">/</kbd>
            </button>

            <button
              id="mobile-nav-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="mobile-nav-menu"
              aria-label="Toggle navigation menu"
              class="md:hidden inline-flex items-center justify-center rounded-lg p-2 text-emerald-100 hover:bg-emerald-900 hover:text-white focus:outline-none focus:ring-2 focus:ring-amber-500"
            >
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Menu -->
      <nav
        id="mobile-nav-menu"
        aria-label="Mobile Navigation"
        class="hidden md:hidden border-t border-emerald-900 bg-emerald-950 px-4 py-3 space-y-1"
      >
        <a href="/#encyclopedia" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">Knowledge Pillars</a>
        <a href="/crops" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">Crop Guides</a>
        <a href="/manufacturing" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">For Manufacturers (B2B)</a>
        <a href="/tools/dosage-calculator" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">Dosage Calculator</a>
        <a href="/tools/tank-mix-checker" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">Tank-Mix Checker</a>
        <a href="/tools/coa-verifier" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">Humic COA Verifier</a>
        <a href="/tools/blend-ph-estimator" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">Blend pH Estimator (B2B)</a>
        <a href="/research-library" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">Research Library</a>
        <a href="/glossary" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">A–Z Glossary</a>
        <a href="/search" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">Search</a>
        <a href="/about" class="block rounded-lg px-3 py-2 text-sm font-medium text-emerald-100 hover:bg-emerald-900 hover:text-amber-400">About &amp; Editorial Policy</a>
      </nav>
    </header>

    <!-- Pagefind Static Search Modal -->
    <div
      id="search-modal"
      role="dialog"
      aria-modal="true"
      aria-label="Search Humic.blog"
      class="hidden fixed inset-0 z-50 bg-slate-950/65 backdrop-blur-xs p-4 sm:p-8 overflow-y-auto"
    >
      <div class="mx-auto max-w-2xl rounded-2xl bg-white border border-slate-200 shadow-2xl overflow-hidden mt-8">
        <div class="flex items-center gap-3 px-4 py-3.5 bg-emerald-950 text-white border-b border-emerald-900">
          <svg class="h-5 w-5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 105.5 5.5a7.5 7.5 0 0011.15 11.15z" />
          </svg>
          <input
            id="pagefind-input"
            type="search"
            autocomplete="off"
            placeholder="Search calcium nitrate, ISO 19822, lignosulfonate, calcareous, sawit, aguacate..."
            class="w-full bg-transparent text-sm sm:text-base text-white placeholder:text-emerald-300/75 focus:outline-none"
          />
          <button
            id="close-search-btn"
            type="button"
            aria-label="Close search"
            class="rounded-lg bg-emerald-900 hover:bg-emerald-800 px-2.5 py-1 text-xs font-semibold text-emerald-200 cursor-pointer"
          >
            Esc
          </button>
        </div>
        <div id="pagefind-results" class="max-h-[65vh] overflow-y-auto divide-y divide-slate-100 p-2">
          <div class="p-6 text-center text-xs text-slate-500">
            Search all guides, interactive tools, and glossary definitions across English, Hindi, Gujarati, Arabic, Spanish, and Indonesian.
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-emerald-950 text-emerald-100 border-t-4 border-amber-500 mt-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-10 border-b border-emerald-900">
          <div class="md:col-span-4 space-y-3">
            <a href="/" class="inline-flex items-center gap-2 font-serif text-xl font-bold text-white">
              Humic<span class="text-amber-500">.blog</span>
            </a>
            <p class="text-sm text-emerald-200/90 leading-relaxed">
              An independent, vendor-neutral educational encyclopedia serving farmers, agronomists, researchers, and biostimulant manufacturers worldwide in 6 languages.
            </p>
            <p class="text-xs text-emerald-300/80 leading-relaxed">
              Editorial Independence: Zero product sponsorships, zero pesticidal or medicinal claims. All protocols align with IHSS and ISO 19822:2018 standards.
            </p>
          </div>

          <div class="md:col-span-3 space-y-2.5">
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-amber-400">
              Knowledge Pillars
            </h3>
            <ul class="space-y-1.5 text-sm">
              <li><a href="/origins" class="hover:text-amber-400 transition-colors">Origins &amp; Chemistry</a></li>
              <li><a href="/raw-materials" class="hover:text-amber-400 transition-colors">Raw Materials &amp; Extraction</a></li>
              <li><a href="/quality-and-testing" class="hover:text-amber-400 transition-colors">Quality &amp; Testing</a></li>
              <li><a href="/agronomy" class="hover:text-amber-400 transition-colors">Agronomy &amp; Application</a></li>
              <li><a href="/crops" class="hover:text-amber-400 transition-colors">Crops &amp; Field Guides</a></li>
              <li><a href="/manufacturing" class="hover:text-amber-400 transition-colors">Formulation &amp; Manufacturing (B2B)</a></li>
              <li><a href="/problem-soils" class="hover:text-amber-400 transition-colors">Problem Soils &amp; Climate</a></li>
              <li><a href="/regulations" class="hover:text-amber-400 transition-colors">Regulations &amp; Organic Standards</a></li>
              <li><a href="/soil-and-sustainability" class="hover:text-amber-400 transition-colors">Soil Health &amp; Sustainability</a></li>
              <li><a href="/gardening" class="hover:text-amber-400 transition-colors">Home Gardening</a></li>
              <li><a href="/comparisons" class="hover:text-amber-400 transition-colors">Humic vs. X Comparisons</a></li>
            </ul>
          </div>

          <div class="md:col-span-3 space-y-2.5">
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-amber-400">
              Tools, Research &amp; Languages
            </h3>
            <ul class="space-y-1.5 text-sm">
              <li><a href="/tools/dosage-calculator" class="hover:text-amber-400 transition-colors">Humate &amp; Fulvic Dosage Calculator</a></li>
              <li><a href="/tools/tank-mix-checker" class="hover:text-amber-400 transition-colors">Tank-Mix Compatibility Checker</a></li>
              <li><a href="/tools/coa-verifier" class="hover:text-amber-400 transition-colors">Humic COA Red-Flag Checker</a></li>
              <li><a href="/tools/blend-ph-estimator" class="hover:text-amber-400 transition-colors">Manufacturer Blend pH Estimator</a></li>
              <li><a href="/crops/master-dosage-table" class="hover:text-amber-400 transition-colors">30-Crop Master Dosage Table</a></li>
              <li><a href="/field-sheets" class="hover:text-amber-400 transition-colors">Printable Field Cheat Sheets</a></li>
              <li><a href="/tools/embed" class="hover:text-amber-400 transition-colors">Free Embeddable Widgets (&lt;/&gt;)</a></li>
              <li><a href="/research-library" class="hover:text-amber-400 transition-colors">Peer-Reviewed Research Library</a></li>
              <li><a href="/glossary" class="hover:text-amber-400 transition-colors">A–Z Humic Science Glossary</a></li>
              <li><a href="/search" class="hover:text-amber-400 transition-colors">Instant Static Search</a></li>
            </ul>
          </div>

          <div class="md:col-span-2 space-y-2.5">
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-amber-400">
              Global Hubs &amp; Policy
            </h3>
            <ul class="space-y-1.5 text-sm">
              <li><a href="/hi" class="hover:text-amber-400 transition-colors">हिन्दी (/hi)</a></li>
              <li><a href="/gu" class="hover:text-amber-400 transition-colors">ગુજરાતી (/gu)</a></li>
              <li><a href="/ar" class="hover:text-amber-400 transition-colors">العربية (/ar)</a></li>
              <li><a href="/es" class="hover:text-amber-400 transition-colors">Español (/es)</a></li>
              <li><a href="/id" class="hover:text-amber-400 transition-colors">Bahasa Indonesia (/id)</a></li>
              <li><a href="/about" class="hover:text-amber-400 transition-colors">About &amp; Editorial</a></li>
              <li><a href="/methodology" class="hover:text-amber-400 transition-colors">Methodology</a></li>
              <li><a href="/llms.txt" class="hover:text-amber-400 transition-colors">llms.txt</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-emerald-300/80">
          <p>&copy; {new Date().getFullYear()} Humic.blog. Open Educational Soil Science Resource.</p>
          <p>Aligned with IHSS &amp; ISO 19822:2018 Analytical Standards.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        // Mobile nav
        const btn = document.getElementById('mobile-nav-toggle');
        const menu = document.getElementById('mobile-nav-menu');
        if (btn && menu) {
          btn.addEventListener('click', function () {
            const isOpen = !menu.classList.contains('hidden');
            menu.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', String(!isOpen));
          });
        }

        // Compact 6-language dropdown
        const langBtn = document.getElementById('lang-dropdown-btn');
        const langMenu = document.getElementById('lang-dropdown-menu');
        const langWrap = document.getElementById('lang-dropdown-wrapper');
        if (langBtn && langMenu && langWrap) {
          langBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            const open = !langMenu.classList.contains('hidden');
            langMenu.classList.toggle('hidden');
            langBtn.setAttribute('aria-expanded', String(!open));
          });
          document.addEventListener('click', function (e) {
            if (!langWrap.contains(e.target)) {
              langMenu.classList.add('hidden');
              langBtn.setAttribute('aria-expanded', 'false');
            }
          });
        }

        // Lazy Pagefind static search modal
        const openBtn = document.getElementById('open-search-btn');
        const closeBtn = document.getElementById('close-search-btn');
        const modal = document.getElementById('search-modal');
        const input = document.getElementById('pagefind-input');
        const resultsEl = document.getElementById('pagefind-results');
        let pf = null;

        async function loadPagefind() {
          if (pf) return pf;
          try {
            pf = await import('/pagefind/pagefind.js');
            await pf.init();
            return pf;
          } catch (e) {
            return null;
          }
        }

        function openSearch() {
          if (!modal || !input) return;
          modal.classList.remove('hidden');
          input.focus();
          loadPagefind();
        }

        function closeSearch() {
          if (!modal) return;
          modal.classList.add('hidden');
        }

        if (openBtn) openBtn.addEventListener('click', openSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);
        if (modal) {
          modal.addEventListener('click', function (e) {
            if (e.target === modal) closeSearch();
          });
        }

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            closeSearch();
            if (langMenu) langMenu.classList.add('hidden');
            if (langBtn) langBtn.setAttribute('aria-expanded', 'false');
          }
          if (
            e.key === '/' &&
            document.activeElement &&
            !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)
          ) {
            e.preventDefault();
            openSearch();
          }
        });

        let timer = null;
        if (input && resultsEl) {
          input.addEventListener('input', function () {
            clearTimeout(timer);
            const q = input.value.trim();
            if (!q) {
              resultsEl.innerHTML =
                '<div class="p-6 text-center text-xs text-slate-500">Search all guides, interactive tools, and glossary definitions across English, Hindi, Gujarati, Arabic, Spanish, and Indonesian.</div>';
              return;
            }
            timer = setTimeout(async function () {
              const engine = await loadPagefind();
              if (!engine) {
                resultsEl.innerHTML =
                  '<div class="p-6 text-center text-xs text-amber-800">Search index loads after production build (Pagefind).</div>';
                return;
              }
              const search = await engine.search(q);
              const top = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
              if (!top.length) {
                resultsEl.innerHTML =
                  '<div class="p-6 text-center text-sm text-slate-500">No matches found for "' +
                  q.replace(/</g, '&lt;') +
                  '".</div>';
                return;
              }
              resultsEl.innerHTML = top
                .map(function (item) {
                  const cleanUrl = item.url.replace(/\/$/, '') || '/';
                  const title = (item.meta && item.meta.title ? item.meta.title : cleanUrl).replace(' | Humic.blog', '');
                  return (
                    '<a href="' +
                    cleanUrl +
                    '" class="block rounded-xl p-3.5 hover:bg-emerald-50 transition-colors">' +
                    '<div class="font-serif text-sm font-bold text-emerald-950">' +
                    title +
                    '</div>' +
                    '<p class="mt-1 text-xs text-slate-600 leading-relaxed line-clamp-2">' +
                    item.excerpt +
                    '</p>' +
                    '</a>'
                  );
                })
                .join('');
            }, 140);
          });
        }
      })();
    </script>
  </body>
</html>
