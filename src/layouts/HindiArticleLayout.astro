---
import BaseLayout from './BaseLayout.astro';
import type { CitationItem, FaqItem, HowToData } from '../components/SchemaMarkup.astro';

export interface Props {
  title: string;
  description: string;
  canonicalAnswer: string;
  canonicalPath: string;
  englishAlternateUrl: string;
  gujaratiAlternateUrl?: string;
  categoryLabel: string;
  pubDate: Date;
  updatedDate?: Date;
  readingMinutes: number;
  faqs: FaqItem[];
  citations: CitationItem[];
  howTo?: HowToData;
}

const {
  title,
  description,
  canonicalAnswer,
  canonicalPath,
  englishAlternateUrl,
  gujaratiAlternateUrl,
  categoryLabel,
  pubDate,
  updatedDate,
  readingMinutes,
  faqs,
  citations,
  howTo,
} = Astro.props;

const siteUrl = 'https://humic.blog';
const fullUrl = `${siteUrl}${canonicalPath}`;

const breadcrumbs = [
  { name: 'होम (Humic.blog)', url: siteUrl },
  { name: 'हिन्दी किसान ज्ञान केंद्र', url: `${siteUrl}/hi` },
  { name: title, url: fullUrl },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  lang="hi"
  alternateUrls={{
    en: englishAlternateUrl,
    hi: fullUrl,
    ...(gujaratiAlternateUrl ? { gu: gujaratiAlternateUrl } : {}),
    xDefault: englishAlternateUrl,
  }}
  schemaType="article"
  pillar={categoryLabel}
  pubDate={pubDate}
  updatedDate={updatedDate}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  citations={citations}
  howTo={howTo}
>
  <div class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-9 sm:py-11">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-emerald-300 flex flex-wrap items-center gap-1.5">
        <a href="/hi" class="hover:text-amber-400">हिन्दी किसान केंद्र</a>
        <span>/</span>
        <span class="text-emerald-100">{categoryLabel}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="inline-flex items-center rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-0.5 text-xs font-semibold text-amber-300">
          हिन्दी कृषि गाइड (IHSS व ISO 19822 आधारित)
        </span>
        <span class="inline-flex items-center rounded-full bg-emerald-900 border border-emerald-700 px-3 py-0.5 text-xs font-medium text-emerald-100">
          {categoryLabel}
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white leading-snug">
        {title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm text-emerald-200/90">
        <span>पढ़ने का समय: {readingMinutes} मिनट</span>
        <span>निष्पक्ष एवं वैज्ञानिक जानकारी</span>
        <a href={englishAlternateUrl.replace(siteUrl, '')} hreflang="en" class="underline decoration-amber-500 underline-offset-2 hover:text-amber-300">
          Read in English &rarr;
        </a>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <article data-pagefind-body class="bg-white rounded-2xl border border-slate-200 shadow-xs p-6 sm:p-10">
      <!-- Canonical Hindi Summary -->
      <aside
        aria-label="संक्षिप्त वैज्ञानिक उत्तर"
        class="mb-8 rounded-xl border border-emerald-900/15 border-l-4 border-l-amber-500 bg-emerald-950/[0.03] p-5 sm:p-6"
      >
        <div class="mb-2 flex items-center gap-2">
          <span class="inline-flex h-2 w-2 rounded-full bg-amber-500" aria-hidden="true"></span>
          <span class="text-xs font-bold tracking-wider text-emerald-900">
            संक्षिप्त वैज्ञानिक उत्तर (त्वरित सारांश)
          </span>
        </div>
        <p class="text-[1.03rem] leading-relaxed text-slate-800 m-0">
          {canonicalAnswer}
        </p>
      </aside>

      <!-- Main Hindi Body -->
      <div class="prose prose-slate max-w-none prose-headings:font-serif prose-headings:text-emerald-950 prose-strong:text-slate-900 leading-relaxed">
        <slot />
      </div>

      <!-- Hindi FAQs -->
      {faqs.length > 0 && (
        <section id="faqs" class="mt-12 pt-8 border-t border-slate-200">
          <div class="flex items-center gap-2 mb-5">
            <span class="h-5 w-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
            <h2 class="font-serif text-2xl font-bold text-emerald-950 m-0">
              किसानों द्वारा अक्सर पूछे जाने वाले प्रश्न (FAQ)
            </h2>
          </div>
          <div class="space-y-4">
            {faqs.map((faq) => (
              <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-5">
                <h3 class="font-serif text-lg font-bold text-emerald-950 mb-2">{faq.question}</h3>
                <p class="text-sm sm:text-[0.96rem] leading-relaxed text-slate-700 m-0">{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Scientific References -->
      {citations.length > 0 && (
        <section id="references" class="mt-12 pt-8 border-t border-slate-200">
          <div class="flex items-center gap-2 mb-4">
            <span class="h-5 w-1.5 rounded-full bg-emerald-900" aria-hidden="true"></span>
            <h2 class="font-serif text-2xl font-bold text-emerald-950 m-0">
              वैज्ञानिक संदर्भ एवं अंतरराष्ट्रीय मानक
            </h2>
          </div>
          <ol class="space-y-2.5 pl-5 list-decimal text-sm text-slate-700 leading-relaxed">
            {citations.map((cite) => (
              <li>
                <span class="font-semibold text-slate-900">{cite.title}.</span>{' '}
                <span class="italic">{cite.source}.</span>{' '}
                {cite.url && (
                  <a href={cite.url} target="_blank" rel="noopener noreferrer" class="text-emerald-800 underline decoration-amber-500">
                    स्रोत / DOI ↗
                  </a>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- Related Hindi Guides & Tools -->
      <aside data-pagefind-ignore class="mt-10 rounded-xl bg-emerald-950 text-white p-6 space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-amber-400">
          किसान उपयोगी कैलकुलेटर व अन्य हिन्दी गाइड
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/hi" class="rounded-lg bg-emerald-900 hover:bg-emerald-800 px-3.5 py-2 text-xs font-semibold text-white">हिन्दी किसान हब</a>
          <a href="/hi/humic-acid-kya-hai-aur-upyog" class="rounded-lg bg-emerald-900 hover:bg-emerald-800 px-3.5 py-2 text-xs font-semibold text-white">ह्यूमिक एसिड उपयोग व मात्रा</a>
          <a href="/hi/asli-nakli-potassium-humate-ki-pehchan" class="rounded-lg bg-emerald-900 hover:bg-emerald-800 px-3.5 py-2 text-xs font-semibold text-white">असली-नकली 3 मिनट टेस्ट</a>
          <a href="/hi/ganne-ki-kheti-mein-humic-acid" class="rounded-lg bg-emerald-900 hover:bg-emerald-800 px-3.5 py-2 text-xs font-semibold text-white">गन्ने की खेती गाइड</a>
          <a href="/tools/dosage-calculator" class="rounded-lg bg-amber-500 hover:bg-amber-400 px-3.5 py-2 text-xs font-bold text-emerald-950">मात्रा कैलकुलेटर &rarr;</a>
          <a href="/tools/tank-mix-checker" class="rounded-lg bg-amber-500 hover:bg-amber-400 px-3.5 py-2 text-xs font-bold text-emerald-950">टैंक-मिक्स जांच &rarr;</a>
        </div>
      </aside>
    </article>
  </div>
</BaseLayout>
