---
import BaseLayout from './BaseLayout.astro';
import type { FaqItem } from '../components/SchemaMarkup.astro';

export interface Props {
  slug: string;
  title: string;
  sheetNumber: string;
  subtitle: string;
  audience: string;
  description: string;
  relatedToolHref: string;
  relatedToolLabel: string;
  faqs?: FaqItem[];
}

const {
  slug,
  title,
  sheetNumber,
  subtitle,
  audience,
  description,
  relatedToolHref,
  relatedToolLabel,
  faqs = [],
} = Astro.props;

const siteUrl = 'https://humic.blog';
const canonicalPath = `/field-sheets/${slug}`;
const fullUrl = `${siteUrl}${canonicalPath}`;

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: 'Printable Field Cheat Sheets', url: `${siteUrl}/field-sheets` },
  { name: title, url: fullUrl },
];
---

<BaseLayout
  title={`${title} — 1-Page Printable Field Sheet`}
  description={description}
  canonicalPath={canonicalPath}
  schemaType="article"
  pillar="Agronomy & Application"
  pubDate={new Date('2026-11-20')}
  updatedDate={new Date('2026-11-20')}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- Screen-only Control Bar -->
  <div class="no-print bg-emerald-950 text-white border-b-4 border-amber-500">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <nav aria-label="Breadcrumb" class="mb-2 text-xs text-emerald-300 flex items-center gap-1.5">
          <a href="/" class="hover:text-amber-400">Home</a>
          <span>/</span>
          <a href="/field-sheets" class="hover:text-amber-400">Field Cheat Sheets</a>
          <span>/</span>
          <span class="text-emerald-100">{sheetNumber}</span>
        </nav>
        <div class="text-xs font-bold uppercase tracking-wider text-amber-400">
          Ink-Friendly A4 / Letter 1-Page Reference &bull; {audience}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <button
          id="print-sheet-btn"
          type="button"
          data-sheet-slug={slug}
          class="inline-flex items-center gap-2 rounded-xl bg-amber-500 hover:bg-amber-400 px-4 py-2.5 text-xs sm:text-sm font-bold text-emerald-950 shadow-sm transition-colors cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2m-2 0H8v4h8v-4z" />
          </svg>
          Print / Save as PDF
        </button>
        <a
          href={relatedToolHref}
          class="inline-flex items-center rounded-xl bg-emerald-900 hover:bg-emerald-800 border border-emerald-700 px-3.5 py-2.5 text-xs font-semibold text-white transition-colors"
        >
          {relatedToolLabel} &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- Printable A4 / Letter 1-Page Sheet -->
  <div data-pagefind-body class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8">
    <article class="print-sheet rounded-2xl bg-white border border-slate-300 shadow-xs p-6 sm:p-8 space-y-5">
      <!-- Crisp Black-on-White Sheet Header -->
      <header class="border-b-2 border-slate-900 pb-3.5 flex flex-wrap items-end justify-between gap-3">
        <div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-slate-600">
            Humic.blog Field Reference &bull; {sheetNumber} &bull; {audience}
          </div>
          <h1 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 leading-tight mt-0.5">
            {title}
          </h1>
          <p class="text-xs sm:text-sm text-slate-700 mt-1 m-0">
            {subtitle}
          </p>
        </div>
        <div class="text-right text-[11px] font-mono text-slate-600 shrink-0">
          <div class="font-bold text-slate-900">humic.blog</div>
          <div>IHSS &amp; ISO 19822 Aligned</div>
        </div>
      </header>

      <!-- Sheet Content -->
      <div class="space-y-4 text-xs sm:text-sm text-slate-900 leading-snug">
        <slot />
      </div>

      <!-- Subtle Attribution Footer (Always Visible on Screen & Print) -->
      <footer class="print-only-footer border-t border-slate-300 pt-2.5 mt-4 flex flex-wrap items-center justify-between gap-2 text-[10.5px] text-slate-600">
        <span>
          <strong class="text-slate-900">humic.blog</strong> &mdash; Independent Humic Science Encyclopedia &bull; Vendor-Neutral Agronomy Reference
        </span>
        <span class="font-mono">{fullUrl}</span>
      </footer>
    </article>

    <!-- Screen-only Bottom Navigation -->
    <div class="no-print mt-6 flex flex-wrap items-center justify-between gap-3 text-xs">
      <a href="/field-sheets" class="font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2">
        &larr; Back to All 4 Printable Field Cheat Sheets
      </a>
      <a href="/crops/master-dosage-table" class="font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2">
        Open 30-Crop Master Dosage Table &rarr;
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById('print-sheet-btn');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var slug = btn.getAttribute('data-sheet-slug') || '';
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'humic_field_sheet_print',
          sheet_name: slug,
        });
        window.print();
      });
    })();
  </script>
</BaseLayout>
