---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TankMixCheckerWidget from '../../components/tools/TankMixCheckerWidget.astro';
import EmbedCodeBox from '../../components/EmbedCodeBox.astro';

const siteUrl = 'https://humic.blog';
const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: 'Tank-Mix Compatibility Checker', url: `${siteUrl}/tools/tank-mix-checker` },
];

const faqs = [
  {
    question: 'Why does Potassium Humate precipitate when mixed with Calcium Nitrate?',
    answer:
      'Potassium humate is stabilized in solution by monovalent potassium ions (K⁺) balancing negatively charged carboxylate (–COO⁻) and phenolate (–O⁻) groups. Introducing divalent calcium (Ca²⁺) displaces potassium and cross-links adjacent humic assemblies into insoluble calcium humate flocs that clog nozzles and drip emitters.',
  },
  {
    question: 'What happens if I mix humic acid with phosphoric or nitric acid?',
    answer:
      'By international IHSS definition, humic acids are soluble at alkaline-to-neutral pH and precipitate below pH 2–4. Strong mineral acids protonate carboxylate groups into neutral carboxylic acid (–COOH), collapsing electrostatic repulsion and forcing humic polymers out of solution as dark sludge.',
  },
  {
    question: 'Does Fulvic Acid have the same tank-mix restrictions as Potassium Humate?',
    answer:
      'No. True fulvic acid (verified via ISO 19822 / DAX-8 resin fractionation) has a lower molecular weight and higher oxygen-containing functional group density, allowing it to remain completely soluble across pH 1–14 and in the presence of calcium or magnesium ions.',
  },
];
---

<BaseLayout
  title="Potassium Humate Tank-Mix Compatibility Checker"
  description="Instant Green/Amber/Red tank-mix compatibility checker for mixing Potassium Humate with Calcium Nitrate, low-pH acids, Urea/NPK, seaweed extract, L-amino acids, and Magnesium Sulfate."
  canonicalPath="/tools/tank-mix-checker"
  schemaType="tool"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div data-pagefind-body class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
      <nav aria-label="Breadcrumb" class="mb-3 text-xs text-emerald-300 flex items-center gap-1.5">
        <a href="/" class="hover:text-amber-400">Home</a>
        <span>/</span>
        <span class="text-emerald-100">Tank-Mix Compatibility Checker</span>
      </nav>
      <span class="inline-flex items-center rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-0.5 text-xs font-semibold text-amber-300 mb-3">
        Precipitation Chemistry Screening
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white leading-tight">
        Humate Tank-Mix Compatibility Checker
      </h1>
      <p class="mt-3 text-sm sm:text-base text-emerald-100/90 max-w-3xl leading-relaxed">
        Prevent emitter clogging, nozzle blockages, and flocculation before mixing. Select a tank-mix partner and water hardness profile to inspect compatibility and precipitation chemistry.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Interactive Checker -->
    <TankMixCheckerWidget />

    <div class="mt-8">
      <EmbedCodeBox slug="tank-mix-checker" toolTitle="Potassium Humate Tank-Mix Compatibility Checker" iframeHeight={720} />
    </div>

    <!-- Full Reference Matrix -->
    <section class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-xs">
      <h2 class="font-serif text-2xl font-bold text-emerald-950 mb-2">
        Potassium Humate Compatibility Matrix (At-a-Glance)
      </h2>
      <p class="text-sm text-slate-600 mb-5">
        Summary for standard alkaline-extracted Potassium Humate (pH 9.0–10.5) in soft-to-moderate irrigation water. Always run a physical 1-liter jar test before scaling to a full spray or fertigation tank.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-emerald-950 text-white">
              <th class="py-3 px-4 font-semibold border-b-2 border-amber-500">Partner Input</th>
              <th class="py-3 px-4 font-semibold border-b-2 border-amber-500">Status</th>
              <th class="py-3 px-4 font-semibold border-b-2 border-amber-500">Primary Chemical Mechanism</th>
              <th class="py-3 px-4 font-semibold border-b-2 border-amber-500">Safe Workaround</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Calcium Nitrate</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-red-100 text-red-800 font-bold text-xs px-2.5 py-0.5">RED — Incompatible</span></td>
              <td class="py-3 px-4 text-slate-700">Divalent Ca²⁺ bridges carboxylate groups into insoluble flocs.</td>
              <td class="py-3 px-4 text-slate-700">Separate A/B fertigation tanks or switch to true Fulvic Acid.</td>
            </tr>
            <tr class="bg-slate-50">
              <td class="py-3 px-4 font-semibold text-slate-900">Low-pH Acids (H₃PO₄ / HNO₃)</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-red-100 text-red-800 font-bold text-xs px-2.5 py-0.5">RED — Incompatible</span></td>
              <td class="py-3 px-4 text-slate-700">Protonation below pH 4–5 precipitates insoluble humic acid sludge.</td>
              <td class="py-3 px-4 text-slate-700">Apply acids in a separate flushing cycle or use Fulvic Acid.</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Magnesium Sulfate (MgSO₄)</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-amber-100 text-amber-900 font-bold text-xs px-2.5 py-0.5">AMBER — Caution</span></td>
              <td class="py-3 px-4 text-slate-700">Divalent Mg²⁺ triggers salting-out in concentrated stock tanks or hard water.</td>
              <td class="py-3 px-4 text-slate-700">Separate stock tanks for drip; jar-test at dilute foliar rates only.</td>
            </tr>
            <tr class="bg-slate-50">
              <td class="py-3 px-4 font-semibold text-slate-900">L-Amino Acids</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-amber-100 text-amber-900 font-bold text-xs px-2.5 py-0.5">AMBER — Conditional</span></td>
              <td class="py-3 px-4 text-slate-700">Acid-hydrolyzed amino products (pH 3.5–5.0) can precipitate humates.</td>
              <td class="py-3 px-4 text-slate-700">Use neutral enzymatic L-amino acids; keep final tank pH ≥ 6.0.</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Urea / Neutral NPK</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-emerald-100 text-emerald-900 font-bold text-xs px-2.5 py-0.5">GREEN — Compatible</span></td>
              <td class="py-3 px-4 text-slate-700">Neutral monovalent solutions preserve humate colloidal stability.</td>
              <td class="py-3 px-4 text-slate-700">Dissolve humate in full tank water first; avoid acidic MAP stocks.</td>
            </tr>
            <tr class="bg-slate-50">
              <td class="py-3 px-4 font-semibold text-slate-900">Seaweed Extract (A. nodosum)</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-emerald-100 text-emerald-900 font-bold text-xs px-2.5 py-0.5">GREEN — Highly Compatible</span></td>
              <td class="py-3 px-4 text-slate-700">Alkaline/neutral kelp extraction aligns with potassium humate pH.</td>
              <td class="py-3 px-4 text-slate-700">Dilute separately into water-filled tank for synergistic foliar/drip use.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQs -->
    <section class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-xs">
      <h2 class="font-serif text-2xl font-bold text-emerald-950 mb-4">Tank-Mix Chemistry FAQs</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
            <h3 class="font-serif text-base font-bold text-emerald-950 mb-1.5">{faq.question}</h3>
            <p class="text-sm text-slate-700 leading-relaxed m-0">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

</BaseLayout>
