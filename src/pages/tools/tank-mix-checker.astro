---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = 'https://humic.blog';
const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: 'Tank-Mix Compatibility Checker', url: `${siteUrl}/tools/tank-mix-checker` },
];

const faqs = [
  {
    question: 'Why does Potassium Humate precipitate when mixed with Calcium Nitrate?',
    answer:
      'Potassium humate is stabilized in solution by monovalent potassium ions (K⁺) balancing negatively charged carboxylate (–COO⁻) and phenolate (–O⁻) groups. Introducing divalent calcium (Ca²⁺) displaces potassium and cross-links adjacent humic assemblies into insoluble calcium humate flocs that clog nozzles and drip emitters.',
  },
  {
    question: 'What happens if I mix humic acid with phosphoric or nitric acid?',
    answer:
      'By international IHSS definition, humic acids are soluble at alkaline-to-neutral pH and precipitate below pH 2–4. Strong mineral acids protonate carboxylate groups into neutral carboxylic acid (–COOH), collapsing electrostatic repulsion and forcing humic polymers out of solution as dark sludge.',
  },
  {
    question: 'Does Fulvic Acid have the same tank-mix restrictions as Potassium Humate?',
    answer:
      'No. True fulvic acid (verified via ISO 19822 / DAX-8 resin fractionation) has a lower molecular weight and higher oxygen-containing functional group density, allowing it to remain completely soluble across pH 1–14 and in the presence of calcium or magnesium ions.',
  },
];
---

<BaseLayout
  title="Potassium Humate Tank-Mix Compatibility Checker"
  description="Instant Green/Amber/Red tank-mix compatibility checker for mixing Potassium Humate with Calcium Nitrate, low-pH acids, Urea/NPK, seaweed extract, L-amino acids, and Magnesium Sulfate."
  canonicalPath="/tools/tank-mix-checker"
  schemaType="tool"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div data-pagefind-body class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
      <nav aria-label="Breadcrumb" class="mb-3 text-xs text-emerald-300 flex items-center gap-1.5">
        <a href="/" class="hover:text-amber-400">Home</a>
        <span>/</span>
        <span class="text-emerald-100">Tank-Mix Compatibility Checker</span>
      </nav>
      <span class="inline-flex items-center rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-0.5 text-xs font-semibold text-amber-300 mb-3">
        Precipitation Chemistry Screening
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white leading-tight">
        Humate Tank-Mix Compatibility Checker
      </h1>
      <p class="mt-3 text-sm sm:text-base text-emerald-100/90 max-w-3xl leading-relaxed">
        Prevent emitter clogging, nozzle blockages, and flocculation before mixing. Select a tank-mix partner and water hardness profile to inspect compatibility and precipitation chemistry.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Interactive Checker -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Controls -->
      <section aria-label="Tank-Mix Selection" class="lg:col-span-5 rounded-2xl bg-white border border-slate-200 p-6 shadow-xs space-y-5">
        <h2 class="font-serif text-xl font-bold text-emerald-950 pb-3 border-b border-slate-200">
          1. Select Mix Components
        </h2>

        <div>
          <span class="block text-sm font-semibold text-slate-800 mb-2">Base Humic Source</span>
          <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Base Humic Source">
            <button
              type="button"
              data-base="khumate"
              class="base-btn rounded-xl border-2 border-emerald-900 bg-emerald-950 text-white px-3 py-2.5 text-xs font-bold transition-all cursor-pointer"
            >
              Potassium Humate<br /><span class="font-normal text-emerald-200">(pH 9.0–10.5)</span>
            </button>
            <button
              type="button"
              data-base="fulvic"
              class="base-btn rounded-xl border border-slate-300 bg-slate-50 text-slate-800 hover:border-emerald-800 px-3 py-2.5 text-xs font-bold transition-all cursor-pointer"
            >
              True Fulvic Acid<br /><span class="font-normal text-slate-500">(Soluble pH 1–14)</span>
            </button>
          </div>
        </div>

        <div>
          <label for="partner-select" class="block text-sm font-semibold text-slate-800 mb-1.5">
            Tank-Mix Partner Input
          </label>
          <select
            id="partner-select"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-medium text-slate-900 focus:border-emerald-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-800/20"
          >
            <option value="calcium_nitrate">Calcium Nitrate — Ca(NO₃)₂</option>
            <option value="low_ph_acids">Low-pH Acids — Phosphoric (H₃PO₄) / Nitric (HNO₃)</option>
            <option value="urea_npk">Urea / Neutral Water-Soluble NPK (e.g., 20-20-20)</option>
            <option value="seaweed">Seaweed Extract (Ascophyllum nodosum)</option>
            <option value="amino_acids">L-Amino Acids (Protein Hydrolysate)</option>
            <option value="magnesium_sulfate">Magnesium Sulfate — Epsom Salt (MgSO₄·7H₂O)</option>
          </select>
        </div>

        <div>
          <label for="water-hardness" class="block text-sm font-semibold text-slate-800 mb-1.5">
            Irrigation / Spray Water Hardness
          </label>
          <select
            id="water-hardness"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-800/20"
          >
            <option value="soft">Soft / Rainwater (&lt;100 ppm CaCO₃)</option>
            <option value="moderate" selected>Moderate Well Water (100–250 ppm CaCO₃)</option>
            <option value="hard">Hard Borewell Water (&gt;250 ppm CaCO₃ / High Ca²⁺+Mg²⁺)</option>
          </select>
        </div>

        <!-- Quick Partner Buttons -->
        <div class="pt-2 border-t border-slate-200">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Quick Select Partner</div>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" data-quick="calcium_nitrate" class="quick-btn rounded-lg border border-slate-200 bg-slate-50 hover:bg-emerald-50 hover:border-emerald-700 px-2.5 py-1.5 text-xs font-medium text-slate-700 cursor-pointer">Calcium Nitrate</button>
            <button type="button" data-quick="low_ph_acids" class="quick-btn rounded-lg border border-slate-200 bg-slate-50 hover:bg-emerald-50 hover:border-emerald-700 px-2.5 py-1.5 text-xs font-medium text-slate-700 cursor-pointer">Phosphoric / Nitric</button>
            <button type="button" data-quick="urea_npk" class="quick-btn rounded-lg border border-slate-200 bg-slate-50 hover:bg-emerald-50 hover:border-emerald-700 px-2.5 py-1.5 text-xs font-medium text-slate-700 cursor-pointer">Urea / NPK</button>
            <button type="button" data-quick="seaweed" class="quick-btn rounded-lg border border-slate-200 bg-slate-50 hover:bg-emerald-50 hover:border-emerald-700 px-2.5 py-1.5 text-xs font-medium text-slate-700 cursor-pointer">Seaweed Extract</button>
            <button type="button" data-quick="amino_acids" class="quick-btn rounded-lg border border-slate-200 bg-slate-50 hover:bg-emerald-50 hover:border-emerald-700 px-2.5 py-1.5 text-xs font-medium text-slate-700 cursor-pointer">L-Amino Acids</button>
            <button type="button" data-quick="magnesium_sulfate" class="quick-btn rounded-lg border border-slate-200 bg-slate-50 hover:bg-emerald-50 hover:border-emerald-700 px-2.5 py-1.5 text-xs font-medium text-slate-700 cursor-pointer">Magnesium Sulfate</button>
          </div>
        </div>
      </section>

      <!-- Result Panel -->
      <section aria-live="polite" aria-label="Compatibility Result" class="lg:col-span-7 rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-sm">
        <div id="status-banner" class="px-6 py-5 bg-red-700 text-white transition-colors">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span id="status-pill" class="inline-flex items-center rounded-full bg-white/20 px-3 py-1 text-xs font-extrabold uppercase tracking-wider">
              RED — INCOMPATIBLE
            </span>
            <span id="status-pair" class="text-xs font-medium text-white/90">
              Potassium Humate + Calcium Nitrate
            </span>
          </div>
          <h2 id="status-headline" class="font-serif text-2xl font-bold mt-2.5 text-white">
            Do Not Tank-Mix — Immediate Calcium Humate Precipitation
          </h2>
        </div>

        <div class="p-6 space-y-5">
          <div>
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1.5">
              Precipitation &amp; Solution Chemistry
            </h3>
            <p id="res-chemistry" class="text-sm text-slate-700 leading-relaxed m-0"></p>
          </div>

          <div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1.5">
              Recommended Field Protocol
            </h3>
            <p id="res-protocol" class="text-sm text-slate-800 leading-relaxed m-0"></p>
          </div>

          <div id="water-note-box" class="hidden rounded-xl bg-amber-50 border border-amber-300 p-4">
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-amber-900 mb-1">
              Hard-Water Warning (&gt;250 ppm CaCO₃)
            </h3>
            <p id="res-water-note" class="text-xs sm:text-sm text-amber-900 leading-relaxed m-0"></p>
          </div>

          <div class="flex flex-wrap gap-3 pt-2 border-t border-slate-200">
            <a href="/agronomy/complete-application-and-tank-mix-guide" class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2">
              Read Complete Application &amp; Tank-Mix Guide &rarr;
            </a>
            <a href="/synergies/humic-seaweed-amino-synergies" class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2">
              Humic + Seaweed + Amino Synergies &rarr;
            </a>
          </div>
        </div>
      </section>
    </div>

    <!-- Full Reference Matrix -->
    <section class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-xs">
      <h2 class="font-serif text-2xl font-bold text-emerald-950 mb-2">
        Potassium Humate Compatibility Matrix (At-a-Glance)
      </h2>
      <p class="text-sm text-slate-600 mb-5">
        Summary for standard alkaline-extracted Potassium Humate (pH 9.0–10.5) in soft-to-moderate irrigation water. Always run a physical 1-liter jar test before scaling to a full spray or fertigation tank.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-emerald-950 text-white">
              <th class="py-3 px-4 font-semibold border-b-2 border-amber-500">Partner Input</th>
              <th class="py-3 px-4 font-semibold border-b-2 border-amber-500">Status</th>
              <th class="py-3 px-4 font-semibold border-b-2 border-amber-500">Primary Chemical Mechanism</th>
              <th class="py-3 px-4 font-semibold border-b-2 border-amber-500">Safe Workaround</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Calcium Nitrate</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-red-100 text-red-800 font-bold text-xs px-2.5 py-0.5">RED — Incompatible</span></td>
              <td class="py-3 px-4 text-slate-700">Divalent Ca²⁺ bridges carboxylate groups into insoluble flocs.</td>
              <td class="py-3 px-4 text-slate-700">Separate A/B fertigation tanks or switch to true Fulvic Acid.</td>
            </tr>
            <tr class="bg-slate-50">
              <td class="py-3 px-4 font-semibold text-slate-900">Low-pH Acids (H₃PO₄ / HNO₃)</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-red-100 text-red-800 font-bold text-xs px-2.5 py-0.5">RED — Incompatible</span></td>
              <td class="py-3 px-4 text-slate-700">Protonation below pH 4–5 precipitates insoluble humic acid sludge.</td>
              <td class="py-3 px-4 text-slate-700">Apply acids in a separate flushing cycle or use Fulvic Acid.</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Magnesium Sulfate (MgSO₄)</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-amber-100 text-amber-900 font-bold text-xs px-2.5 py-0.5">AMBER — Caution</span></td>
              <td class="py-3 px-4 text-slate-700">Divalent Mg²⁺ triggers salting-out in concentrated stock tanks or hard water.</td>
              <td class="py-3 px-4 text-slate-700">Separate stock tanks for drip; jar-test at dilute foliar rates only.</td>
            </tr>
            <tr class="bg-slate-50">
              <td class="py-3 px-4 font-semibold text-slate-900">L-Amino Acids</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-amber-100 text-amber-900 font-bold text-xs px-2.5 py-0.5">AMBER — Conditional</span></td>
              <td class="py-3 px-4 text-slate-700">Acid-hydrolyzed amino products (pH 3.5–5.0) can precipitate humates.</td>
              <td class="py-3 px-4 text-slate-700">Use neutral enzymatic L-amino acids; keep final tank pH ≥ 6.0.</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Urea / Neutral NPK</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-emerald-100 text-emerald-900 font-bold text-xs px-2.5 py-0.5">GREEN — Compatible</span></td>
              <td class="py-3 px-4 text-slate-700">Neutral monovalent solutions preserve humate colloidal stability.</td>
              <td class="py-3 px-4 text-slate-700">Dissolve humate in full tank water first; avoid acidic MAP stocks.</td>
            </tr>
            <tr class="bg-slate-50">
              <td class="py-3 px-4 font-semibold text-slate-900">Seaweed Extract (A. nodosum)</td>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-emerald-100 text-emerald-900 font-bold text-xs px-2.5 py-0.5">GREEN — Highly Compatible</span></td>
              <td class="py-3 px-4 text-slate-700">Alkaline/neutral kelp extraction aligns with potassium humate pH.</td>
              <td class="py-3 px-4 text-slate-700">Dilute separately into water-filled tank for synergistic foliar/drip use.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQs -->
    <section class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-xs">
      <h2 class="font-serif text-2xl font-bold text-emerald-950 mb-4">Tank-Mix Chemistry FAQs</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
            <h3 class="font-serif text-base font-bold text-emerald-950 mb-1.5">{faq.question}</h3>
            <p class="text-sm text-slate-700 leading-relaxed m-0">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      const MATRIX = {
        khumate: {
          calcium_nitrate: {
            level: 'red',
            pill: 'RED — INCOMPATIBLE',
            headline: 'Do Not Tank-Mix — Immediate Calcium Humate Flocculation',
            chemistry:
              'Divalent calcium ions (Ca²⁺) rapidly displace monovalent potassium (K⁺) on humic carboxylate (–COO⁻) and phenolate sites, forming cation bridges between supramolecular assemblies. The resulting calcium humate complex loses hydration and precipitates instantly as dense dark flocs.',
            protocol:
              'Never combine Potassium Humate and Calcium Nitrate in the same concentrate tank or spray tank. In drip fertigation, inject Calcium Nitrate through Tank A and Potassium Humate through Tank B with a 15-minute clean-water flush between cycles, or substitute verified Fulvic Acid.',
          },
          low_ph_acids: {
            level: 'red',
            pill: 'RED — INCOMPATIBLE',
            headline: 'Do Not Tank-Mix — Acid-Induced Humic Precipitation',
            chemistry:
              'Humic acids are operationally defined by their insolubility in acid. Adding phosphoric acid (H₃PO₄), nitric acid (HNO₃), or sulfuric acid drops solution pH below 4.0–5.0, protonating anionic carboxylate groups into uncharged carboxylic acid (–COOH) and crashing humic solids out as thick black sludge.',
            protocol:
              'Maintain tank solution pH above 6.0 whenever Potassium Humate is present. Perform acid-based drip-line descaling on separate irrigation days after thoroughly flushing all humic residues from pipes and filters.',
          },
          urea_npk: {
            level: 'green',
            pill: 'GREEN — COMPATIBLE',
            headline: 'Compatible in Diluted Solutions — Follow Mixing Order',
            chemistry:
              'Urea is electrically neutral and standard neutral-pH water-soluble NPK formulations (potassium nitrate, neutral 20-20-20) supply monovalent ions that do not bridge humic colloids. Co-application with urea can also help moderate localized ammonia volatilization in soil.',
            protocol:
              'Fill the spray or fertigation tank at least 75% with water, dissolve Potassium Humate completely first, then add pre-dissolved Urea or neutral NPK under continuous agitation. Note: strongly acidic Monoammonium Phosphate (MAP) or calcium-fortified NPK blends require a jar test or separate tank.',
          },
          seaweed: {
            level: 'green',
            pill: 'GREEN — HIGHLY COMPATIBLE',
            headline: 'Highly Compatible — Synergistic Alkaline/Neutral Profile',
            chemistry:
              'Alkaline-extracted Ascophyllum nodosum kelp concentrates typically exhibit a neutral-to-alkaline pH (7.5–10.0) and contain alginates, mannitol, and betaines that remain stably dispersed alongside potassium humate anions without cross-linking.',
            protocol:
              'Ideal co-application for root-zone conditioning and abiotic stress management. Fill tank 75% with clean water, add dissolved Potassium Humate, then add Seaweed Extract under gentle agitation. Check pH if using an acid-stabilized cold-pressed kelp formulation.',
          },
          amino_acids: {
            level: 'amber',
            pill: 'AMBER — CONDITIONAL (CHECK pH)',
            headline: 'Conditionally Compatible — Depends on Hydrolysate pH',
            chemistry:
              'Enzymatically hydrolyzed L-amino acids near neutral pH (6.0–7.0) mix cleanly with Potassium Humate. However, chemically acid-hydrolyzed protein products (pH 3.5–5.0) or high-salt animal hydrolysates can protonate humic functional groups and trigger micro-flocculation.',
            protocol:
              'Always measure the final spray solution pH and conduct a 1-liter jar test (stand 30 minutes). Dissolve Potassium Humate in full water volume first so its natural alkalinity buffers the water, then slowly add L-amino acids while keeping final tank pH ≥ 6.0.',
          },
          magnesium_sulfate: {
            level: 'amber',
            pill: 'AMBER — CAUTION (DIVALENT Mg²⁺)',
            headline: 'Caution — Concentration & Water-Hardness Dependent',
            chemistry:
              'Magnesium (Mg²⁺) is a divalent cation capable of bridging negatively charged humic carboxylates. Although hydrated Mg²⁺ precipitates humates less aggressively than Ca²⁺, concentrated fertigation stock tanks or hard borewell water will induce salting-out and slow flocculation.',
            protocol:
              'Do NOT mix Potassium Humate and Magnesium Sulfate in concentrated fertigation stock tanks—inject via separate A/B tanks. For dilute foliar sprays (≤0.1% humate + ≤0.5% MgSO₄ in soft water), perform a 30-minute jar test before filling the sprayer.',
          },
        },
        fulvic: {
          calcium_nitrate: {
            level: 'green',
            pill: 'GREEN — COMPATIBLE (FULVIC)',
            headline: 'Compatible — True Fulvic Acid Chelates Ca²⁺ Without Precipitating',
            chemistry:
              'Unlike high-molecular-weight humic acids, verified ISO 19822 fulvic acids possess lower molecular weight (<2 kDa) and higher carboxyl/hydroxyl density. They form water-soluble coordination complexes with divalent Ca²⁺ instead of flocculating.',
            protocol:
              'Ensure the product is genuine DAX-8 verified Fulvic Acid (yellow-amber solution) rather than disguised potassium humate or lignosulfonate. Dissolve Calcium Nitrate and Fulvic Acid separately before combining in the diluted tank.',
          },
          low_ph_acids: {
            level: 'green',
            pill: 'GREEN — COMPATIBLE (FULVIC)',
            headline: 'Compatible — Fulvic Acid Remains Soluble Across pH 1–14',
            chemistry:
              'By IHSS operational definition, fulvic acids remain completely soluble in strongly acidic solutions (even pH 1.0) because their abundant hydrophilic oxygen functional groups maintain hydration even when protonated.',
            protocol:
              'Safe for inclusion in acidified fertigation programs (pH 5.5–6.0) used in calcareous soils. Always add acid to water safely (never water to concentrated acid) before adding diluted fulvic acid.',
          },
          urea_npk: {
            level: 'green',
            pill: 'GREEN — COMPATIBLE (FULVIC)',
            headline: 'Fully Compatible Across Neutral & Acidic NPK Blends',
            chemistry:
              'True fulvic acid integrates cleanly with urea, UAN, MAP, MKP, and micronutrient-enriched water-soluble NPK blends without salting out.',
            protocol:
              'Dissolve fertilizers in water first, then add fulvic acid at recommended foliar (0.05–0.1%) or fertigation rates under standard agitation.',
          },
          seaweed: {
            level: 'green',
            pill: 'GREEN — HIGHLY COMPATIBLE',
            headline: 'Highly Compatible — Broad-Spectrum Biostimulant Pairing',
            chemistry:
              'Fulvic acid remains soluble across both alkaline-extracted and acid-stabilized cold-pressed Ascophyllum nodosum seaweed extracts.',
            protocol:
              'Combine in diluted tank water for foliar or drip programs targeting early root establishment and abiotic stress resilience.',
          },
          amino_acids: {
            level: 'green',
            pill: 'GREEN — COMPATIBLE (FULVIC)',
            headline: 'Compatible — No Acid Precipitation Risk',
            chemistry:
              'Because fulvic acid stays soluble at low pH, both neutral enzymatic and mildly acidic L-amino acid formulations combine cleanly without sludge formation.',
            protocol:
              'Mix into water-filled tank under standard agitation. Ideal low-residue foliar tank mix for high-value horticultural crops.',
          },
          magnesium_sulfate: {
            level: 'green',
            pill: 'GREEN — COMPATIBLE (FULVIC)',
            headline: 'Compatible — Soluble Mg²⁺ Complexation',
            chemistry:
              'Fulvic acid complexes divalent Mg²⁺ in solution without cross-linking into precipitates, supporting foliar magnesium uptake and fertigation delivery.',
            protocol:
              'Dissolve Epsom salt fully in tank water before introducing fulvic acid. Verify with a brief jar test when using very hard borewell water.',
          },
        },
      };

      const PARTNER_NAMES = {
        calcium_nitrate: 'Calcium Nitrate',
        low_ph_acids: 'Phosphoric / Nitric Acid',
        urea_npk: 'Urea / Neutral NPK',
        seaweed: 'Seaweed Extract (A. nodosum)',
        amino_acids: 'L-Amino Acids',
        magnesium_sulfate: 'Magnesium Sulfate',
      };

      const BANNER_COLORS = {
        red: 'bg-red-700 text-white',
        amber: 'bg-amber-600 text-white',
        green: 'bg-emerald-800 text-white',
      };

      let activeBase = 'khumate';

      const elPartner = document.getElementById('partner-select');
      const elWater = document.getElementById('water-hardness');
      const baseBtns = Array.from(document.querySelectorAll('.base-btn'));
      const quickBtns = Array.from(document.querySelectorAll('.quick-btn'));

      const elBanner = document.getElementById('status-banner');
      const elPill = document.getElementById('status-pill');
      const elPair = document.getElementById('status-pair');
      const elHeadline = document.getElementById('status-headline');
      const elChem = document.getElementById('res-chemistry');
      const elProto = document.getElementById('res-protocol');
      const elWaterBox = document.getElementById('water-note-box');
      const elWaterNote = document.getElementById('res-water-note');

      function render() {
        const partner = elPartner.value;
        const water = elWater.value;
        const entry = MATRIX[activeBase][partner];

        let effectiveLevel = entry.level;
        let effectivePill = entry.pill;

        if (activeBase === 'khumate' && water === 'hard') {
          if (partner === 'magnesium_sulfate') {
            effectiveLevel = 'red';
            effectivePill = 'RED — HARD-WATER PRECIPITATION RISK';
          } else if (effectiveLevel === 'green') {
            effectiveLevel = 'amber';
            effectivePill = 'AMBER — HARD WATER CAUTION';
          }
        }

        elBanner.className = 'px-6 py-5 transition-colors ' + BANNER_COLORS[effectiveLevel];
        elPill.textContent = effectivePill;
        elPair.textContent =
          (activeBase === 'khumate' ? 'Potassium Humate' : 'True Fulvic Acid') +
          ' + ' +
          PARTNER_NAMES[partner];
        elHeadline.textContent = entry.headline;
        elChem.textContent = entry.chemistry;
        elProto.textContent = entry.protocol;

        if (water === 'hard' && activeBase === 'khumate') {
          elWaterBox.classList.remove('hidden');
          elWaterNote.textContent =
            'Your borewell water exceeds 250 ppm CaCO₃ equivalent. Ambient Ca²⁺ and Mg²⁺ in the carrier water itself can partially flocculate Potassium Humate even with compatible partners. Pre-dilute humate in softened/rainwater if possible, increase dilution ratio, keep 120-mesh filters clean, or switch to Fulvic Acid.';
        } else if (water === 'hard' && activeBase === 'fulvic') {
          elWaterBox.classList.remove('hidden');
          elWaterNote.textContent =
            'Hard borewell water (>250 ppm CaCO₃) is well tolerated by verified ISO 19822 Fulvic Acid. Always confirm your fulvic source is genuine and free of unrefined humic fractions that precipitate in hard water.';
        } else {
          elWaterBox.classList.add('hidden');
        }
      }

      baseBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeBase = btn.getAttribute('data-base');
          baseBtns.forEach(function (b) {
            const isSel = b.getAttribute('data-base') === activeBase;
            b.className = isSel
              ? 'base-btn rounded-xl border-2 border-emerald-900 bg-emerald-950 text-white px-3 py-2.5 text-xs font-bold transition-all cursor-pointer'
              : 'base-btn rounded-xl border border-slate-300 bg-slate-50 text-slate-800 hover:border-emerald-800 px-3 py-2.5 text-xs font-bold transition-all cursor-pointer';
          });
          render();
        });
      });

      quickBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          elPartner.value = btn.getAttribute('data-quick');
          render();
        });
      });

      function trackMix() {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'humic_tool_interaction',
          tool_name: 'tank_mix_checker',
          action_detail: activeBase + '+' + elPartner.value + ':' + elWater.value + '->' + elPill.textContent,
        });
      }
      baseBtns.forEach(function (b) { b.addEventListener('click', trackMix); });
      quickBtns.forEach(function (b) { b.addEventListener('click', trackMix); });
      elPartner.addEventListener('change', function () { render(); trackMix(); });
      elWater.addEventListener('change', function () { render(); trackMix(); });

      render();
    })();
  </script>
</BaseLayout>
