---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlendPhEstimatorWidget from '../../components/tools/BlendPhEstimatorWidget.astro';
import EmbedCodeBox from '../../components/EmbedCodeBox.astro';

const siteUrl = 'https://humic.blog';
const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: 'Manufacturer Blend pH & Stability Estimator', url: `${siteUrl}/tools/blend-ph-estimator` },
];

const faqs = [
  {
    question: 'Why does Potassium Humate precipitate when target bottle pH drops below 5.5?',
    answer:
      'Potassium humate stays dispersed through electrostatic repulsion between negatively charged carboxylate (–COO⁻) groups. Below pH 5.5, protonation weakens colloidal zeta potential, causing gradual thickening/gelation; below pH 4.5–5.0, humic acid precipitates as dense dark sludge. Acidic concentrates require Acid-Soluble Potassium Fulvate.',
  },
  {
    question: 'Why do Micronutrient Sulfates crash inside alkaline Potassium Humate bottles?',
    answer:
      'Unchelated metal sulfates (FeSO₄, ZnSO₄, MnSO₄, MgSO₄) supply free divalent cations that cross-link humate polymers AND rapidly hydrolyze into insoluble metal hydroxides (rusty/grey sludge) above pH 6.8–7.5. Formulators must either switch to EDTA/EDDHA chelated trace elements at pH 7.5–8.5 or switch the humic base to Acid-Soluble Potassium Fulvate at pH 4.0–5.2.',
  },
  {
    question: 'How does hard factory water (>300 ppm CaCO₃) affect liquid concentrate shelf life?',
    answer:
      'Ambient Ca²⁺ and Mg²⁺ ions in hard plant water slowly bridge potassium humate colloids during storage, producing gritty bottom sediment within 2–6 weeks. Always manufacture liquid humic concentrates with RO/deionized water (<50 µS/cm) and 0.3%–0.5% tripotassium citrate.',
  },
];
---

<BaseLayout
  title="Manufacturer Blend pH & Stability Estimator (B2B Liquid Biostimulants)"
  description="Interactive B2B formulation stability estimator for biostimulant manufacturers blending Potassium Humate or Potassium Fulvate with seaweed extract, L-amino acids, and micronutrient sulfates across pH 3.0–10.0."
  canonicalPath="/tools/blend-ph-estimator"
  schemaType="tool"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
      <nav aria-label="Breadcrumb" class="mb-3 text-xs text-emerald-300 flex items-center gap-1.5">
        <a href="/" class="hover:text-amber-400">Home</a>
        <span>/</span>
        <span class="text-emerald-100">Blend pH &amp; Stability Estimator</span>
      </nav>
      <span class="inline-flex items-center rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-0.5 text-xs font-semibold text-amber-300 mb-3">
        B2B Formulation Engineering Tool
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white leading-tight">
        Manufacturer Blend pH &amp; Stability Estimator
      </h1>
      <p class="mt-3 text-sm sm:text-base text-emerald-100/90 max-w-3xl leading-relaxed">
        Evaluate precipitation, gelation, and sedimentation risk before running pilot batches. Select your humic source, partner biostimulant, target concentrate pH (3.0–10.0), and factory water hardness.
      </p>
    </div>
  </div>

  <div data-pagefind-body class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <BlendPhEstimatorWidget />

    <div class="mt-8">
      <EmbedCodeBox slug="blend-ph-estimator" toolTitle="Manufacturer Blend pH & Stability Estimator" iframeHeight={740} />
    </div>

    <!-- FAQs -->
    <section class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-xs">
      <h2 class="font-serif text-2xl font-bold text-emerald-950 mb-4">Formulation Stability FAQs</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
            <h3 class="font-serif text-base font-bold text-emerald-950 mb-1.5">{faq.question}</h3>
            <p class="text-sm text-slate-700 leading-relaxed m-0">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

</BaseLayout>
