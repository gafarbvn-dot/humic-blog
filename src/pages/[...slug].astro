---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const words = entry.body.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(4, Math.ceil(words / 220));
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalAnswer={entry.data.canonicalAnswer}
  pillar={entry.data.pillar}
  isPillarPage={entry.data.isPillarPage}
  audience={entry.data.audience}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  slug={entry.slug}
  headings={headings}
  faqs={entry.data.faqs}
  citations={entry.data.citations}
  howTo={entry.data.howTo}
  readingMinutes={readingMinutes}
>
  <Content />
</ArticleLayout>
