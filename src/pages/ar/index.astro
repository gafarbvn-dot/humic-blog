---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = 'https://humic.blog';
const breadcrumbs = [
  { name: 'Humic.blog', url: siteUrl },
  { name: 'المركز العربي لأحماض الهيوميك', url: `${siteUrl}/ar` },
];

const guides = [
  {
    href: '/ar/humic-acid-saline-calcareous-soils',
    badge: 'التربة الصحراوية والري بالتنقيط',
    title: 'حمض الهيوميك في التربة المالحة والجيرية: تحسين الخصوبة وكفاءة الري بالتنقيط',
    summary:
      'دليل علمي متكامل لمزارع الخليج والشرق الأوسط حول التعامل مع ارتفاع الرقم الهيدروجيني (pH 7.8–8.8)، تثبيت الفوسفور والحديد، تخفيف إجهاد الملوحة، ومنع انسداد النقاطات في مياه الآبار العسرة.',
  },
  {
    href: '/ar/potassium-humate-vs-sodium-humate-guide',
    badge: 'الجودة وفحص شهادة التحليل ISO 19822',
    title: 'هيومات البوتاسيوم مقابل هيومات الصوديوم: دليل المزارع والمستورد لاختيار الجودة وفحص ISO 19822',
    summary:
      'لماذا تدمر هيومات الصوديوم بنية التربة في المناطق الجافة، وكيف تفحص شهادة التحليل المخبرية (COA) لاكتشاف الغش بلجنوسلفونات الصوديوم (>0.75% كبريت) قبل استيراد الحاويات أو الشراء للمزرعة.',
  },
];
---

<BaseLayout
  title="المركز العربي لأحماض الهيوميك — التربة المالحة والجيرية وجودة ISO 19822 | Humic.blog"
  description="موسوعة علمية محايدة باللغة العربية لمزارعي ومهندسي ومستوردي الخليج والشرق الأوسط حول حمض الهيوميك والفولفيك في التربة المالحة والجيرية ومعايير فحص ISO 19822."
  canonicalPath="/ar"
  lang="ar"
  alternateUrls={{
    en: 'https://humic.blog',
    hi: 'https://humic.blog/hi',
    gu: 'https://humic.blog/gu',
    ar: 'https://humic.blog/ar',
    es: 'https://humic.blog/es',
    id: 'https://humic.blog/id',
    xDefault: 'https://humic.blog',
  }}
  schemaType="collection"
  breadcrumbs={breadcrumbs}
>
  <section class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-900 border border-emerald-700 px-3.5 py-1 text-xs font-semibold text-amber-400 mb-5">
        <span class="h-2 w-2 rounded-full bg-amber-400" aria-hidden="true"></span>
        موسوعة علمية مستقلة &bull; متوافقة مع IHSS و ISO 19822 &bull; مخصصة لبيئة الخليج والشرق الأوسط
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white leading-tight max-w-4xl">
        المركز العربي <span class="text-amber-400">لعلوم أحماض الهيوميك والفولفيك</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-emerald-100/90 leading-relaxed max-w-3xl">
        مرجع زراعي محايد للمزارعين والمهندسين ومستوردي المدخلات الزراعية في دول الخليج والشرق الأوسط وشمال أفريقيا—يركز على إدارة التربة الجيرية والمالحة، سلامة شبكات الري بالتنقيط، وتدقيق جودة هيومات البوتاسيوم وفق معيار ISO 19822.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/ar/humic-acid-saline-calcareous-soils" class="rounded-xl bg-amber-500 hover:bg-amber-400 px-5 py-3 text-sm font-bold text-emerald-950 transition-colors">
          دليل التربة المالحة والجيرية &larr;
        </a>
        <a href="/ar/potassium-humate-vs-sodium-humate-guide" class="rounded-xl bg-emerald-900 hover:bg-emerald-800 border border-emerald-700 px-5 py-3 text-sm font-semibold text-white transition-colors">
          هيومات البوتاسيوم مقابل الصوديوم
        </a>
        <a href="/tools/coa-verifier" class="rounded-xl bg-transparent hover:bg-emerald-900/60 border border-emerald-600 px-5 py-3 text-sm font-semibold text-emerald-100 transition-colors">
          أداة فحص شهادة التحليل (COA)
        </a>
      </div>
    </div>
  </section>

  <div data-pagefind-body class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <section class="space-y-5">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600">الأدلة المرجعية باللغة العربية</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-emerald-950 mt-1">
          مقالات علمية وعملية لبيئة الشرق الأوسط والخليج
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-5">
        {guides.map((g) => (
          <article class="rounded-2xl bg-white border border-slate-200 hover:border-amber-500 p-6 sm:p-7 shadow-xs transition-colors">
            <span class="inline-flex items-center rounded-full bg-emerald-950/5 border border-emerald-900/15 px-3 py-0.5 text-xs font-semibold text-emerald-900 mb-2.5">
              {g.badge}
            </span>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-emerald-950 leading-snug">
              <a href={g.href} class="hover:text-emerald-700 underline decoration-transparent hover:decoration-amber-500 underline-offset-4">
                {g.title}
              </a>
            </h3>
            <p class="mt-2.5 text-sm sm:text-base text-slate-700 leading-relaxed">{g.summary}</p>
            <div class="mt-4">
              <a href={g.href} class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-900 hover:bg-emerald-950 px-4 py-2 text-xs font-bold text-white transition-colors">
                قراءة الدليل الكامل &larr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-emerald-950 text-white p-6 sm:p-8 space-y-4">
      <div class="text-xs font-bold uppercase tracking-wider text-amber-400">أدوات حقلية وتدقيق جودة مجانية</div>
      <h2 class="font-serif text-2xl font-bold text-white m-0">تحقق من الجرعات والتوافق والجودة قبل الاستخدام</h2>
      <p class="text-sm text-emerald-100/90 leading-relaxed max-w-2xl">
        استخدم حاسباتنا التفاعلية لتقدير معدلات التسميد بالري بالتنقيط، التحقق من توافق الخلط مع نترات الكالسيوم والأحماض، واكتشاف علامات الغش في شهادات التحليل قبل الاستيراد.
      </p>
      <div class="flex flex-wrap gap-2.5 pt-1">
        <a href="/tools/dosage-calculator" class="rounded-lg bg-amber-500 hover:bg-amber-400 px-4 py-2.5 text-xs font-bold text-emerald-950">حاسبة الجرعات &larr;</a>
        <a href="/tools/tank-mix-checker" class="rounded-lg bg-emerald-900 hover:bg-emerald-800 border border-emerald-700 px-4 py-2.5 text-xs font-semibold text-white">فحص توافق الخلط &larr;</a>
        <a href="/tools/coa-verifier" class="rounded-lg bg-emerald-900 hover:bg-emerald-800 border border-emerald-700 px-4 py-2.5 text-xs font-semibold text-white">مدقق شهادة التحليل COA &larr;</a>
        <a href="/tools/blend-ph-estimator" class="rounded-lg bg-emerald-900 hover:bg-emerald-800 border border-emerald-700 px-4 py-2.5 text-xs font-semibold text-white">مقدر استقرار التركيبات (B2B) &larr;</a>
      </div>
    </section>
  </div>
</BaseLayout>
