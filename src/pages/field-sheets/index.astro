---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = 'https://humic.blog';
const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: 'Print-Ready Field Cheat Sheets', url: `${siteUrl}/field-sheets` },
];

const sheets = [
  {
    slug: 'tank-mix-compatibility-chart',
    number: 'SHEET 01',
    audience: 'Farmers, Drip Operators & Spray Crews',
    title: 'Tank-Mix Compatibility Chart & 1-Liter Jar Test Protocol',
    summary:
      'One-page Do & Don’t mixing matrix comparing Potassium Humate vs. Fulvic Acid across Calcium Nitrate, low-pH acids, Urea/NPK, Magnesium/Micronutrient Sulfates, Seaweed Extract, and L-Amino Acids, plus a 4-step 1-liter jar test.',
  },
  {
    slug: '3-minute-farm-adulteration-test',
    number: 'SHEET 02',
    audience: 'Farmers, Agronomists & Agri-Dealers',
    title: '3-Minute Farm Adulteration Field Test (No Lab Needed)',
    summary:
      'Step-by-step clean water, white vinegar precipitation, and warm-water foam/odor protocol to spot raw coal dust, sodium lignosulfonate, and molasses—plus the sodium humate (NaOH) lab-COA warning.',
  },
  {
    slug: 'universal-humic-crop-calendar',
    number: 'SHEET 03',
    audience: 'Crop Advisors & Farm Managers',
    title: 'Universal Humic Crop Calendar & 5 Golden Precautions',
    summary:
      'Stage-by-stage physiological timing guide from Pre-Planting & Basal → Germination & Seed Coating → Vegetative Root Flush → Pre-Flowering & Fruit Set, paired with 5 essential field precautions.',
  },
  {
    slug: 'humic-coa-audit-checklist',
    number: 'SHEET 04',
    audience: 'B2B Buyers, Importers & Formulators',
    title: 'Humic Acid COA Audit Checklist (ISO 19822 Procurement)',
    summary:
      'Container-level quality audit sheet with Pass / Caution / Reject limits for ISO 19822 verification, Sulfur (< 0.75% lignosulfonate screen), Sodium (< 1.5% NaOH screen), K₂O, Water Insolubles, Mass Balance, and Heavy Metals.',
  },
];
---

<BaseLayout
  title="Print-Ready Humic Acid Field Cheat Sheets (1-Page A4 / Letter PDFs)"
  description="Four ink-friendly, one-page printable agronomy cheat sheets for pump houses, spray rooms, dealer counters, and procurement desks: Tank-Mix Chart, 3-Minute Adulteration Test, Crop Calendar, and COA Audit Checklist."
  canonicalPath="/field-sheets"
  schemaType="collection"
  breadcrumbs={breadcrumbs}
>
  <section class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
      <nav aria-label="Breadcrumb" class="mb-3 text-xs text-emerald-300 flex items-center gap-1.5">
        <a href="/" class="hover:text-amber-400">Home</a>
        <span>/</span>
        <span class="text-emerald-100">Printable Field Cheat Sheets</span>
      </nav>
      <span class="inline-flex items-center rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-0.5 text-xs font-semibold text-amber-300 mb-3">
        Ink-Friendly 1-Page A4 / Letter References &bull; Zero Brand Ads
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white leading-tight max-w-4xl">
        Print-Ready Humic Science Field Cheat Sheets
      </h1>
      <p class="mt-3 text-sm sm:text-base text-emerald-100/90 max-w-3xl leading-relaxed">
        Designed for fertigation pump houses, spray-mixing sheds, agri-input counters, university classrooms, and B2B procurement offices. Open any sheet and click <strong>Print / Save as PDF</strong> for a crisp black-on-white 1-page reference with all website navigation automatically hidden.
      </p>
    </div>
  </section>

  <div data-pagefind-body class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sheets.map((sheet) => (
        <article class="rounded-2xl bg-white border border-slate-200 hover:border-amber-500 p-6 shadow-xs transition-colors flex flex-col justify-between gap-4">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2.5">
              <span class="rounded-md bg-emerald-950 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-amber-400">
                {sheet.number}
              </span>
              <span class="text-[11px] font-semibold text-slate-500">{sheet.audience}</span>
            </div>
            <h2 class="font-serif text-xl font-bold text-emerald-950 leading-snug">
              <a href={`/field-sheets/${sheet.slug}`} class="hover:text-emerald-700 underline decoration-transparent hover:decoration-amber-500 underline-offset-4">
                {sheet.title}
              </a>
            </h2>
            <p class="mt-2 text-sm text-slate-700 leading-relaxed">{sheet.summary}</p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[11px] font-mono text-slate-500">1-Page A4 / Letter</span>
            <a
              href={`/field-sheets/${sheet.slug}`}
              class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-900 hover:bg-emerald-950 px-4 py-2 text-xs font-bold text-white transition-colors"
            >
              Open &amp; Print Sheet &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Cross-link Banner to 30-Crop Master Table -->
    <section class="rounded-2xl bg-emerald-950 text-white p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-5">
      <div class="space-y-1.5 max-w-2xl">
        <div class="text-xs font-bold uppercase tracking-wider text-amber-400">Interactive Companion Dataset</div>
        <h2 class="font-serif text-2xl font-bold text-white m-0">
          Looking for Exact Crop-by-Crop Dosage Rates?
        </h2>
        <p class="text-sm text-emerald-100/90 m-0">
          Search 30 global crops with instant Per Acre / Per Hectare unit switching in our Master Dosage Matrix, or embed any of our 4 free calculators on your own site.
        </p>
      </div>
      <div class="flex flex-wrap gap-2.5 shrink-0">
        <a href="/crops/master-dosage-table" class="rounded-lg bg-amber-500 hover:bg-amber-400 px-4 py-2.5 text-xs font-bold text-emerald-950">
          30-Crop Dosage Table &rarr;
        </a>
        <a href="/tools/embed" class="rounded-lg bg-emerald-900 hover:bg-emerald-800 border border-emerald-700 px-4 py-2.5 text-xs font-semibold text-white">
          Embed Free Tools &rarr;
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
