---
import BaseLayout from '../layouts/BaseLayout.astro';

interface GlossaryTerm {
  id: string;
  term: string;
  abbr?: string;
  category: 'Soil Chemistry' | 'Analytical Standards' | 'Raw Materials' | 'Agronomy';
  standard: string;
  definition: string;
  relatedSlug?: string;
  relatedLabel?: string;
}

const terms: GlossaryTerm[] = [
  {
    id: 'alkaline-extraction',
    term: 'Alkaline Extraction',
    category: 'Raw Materials',
    standard: 'IHSS / ISO 19822',
    definition:
      'The industrial and laboratory process of solubilizing humic and fulvic acids from oxidized lignite (leonardite), peat, or soil using an aqueous base—typically potassium hydroxide (KOH) for agricultural potassium humate or sodium hydroxide (NaOH) for analytical assays—leaving insoluble humin and mineral ash behind.',
    relatedSlug: '/raw-materials/raw-materials-and-extraction',
    relatedLabel: 'Raw Materials & Extraction Guide',
  },
  {
    id: 'cation-exchange-capacity',
    term: 'Cation Exchange Capacity (CEC)',
    abbr: 'CEC',
    category: 'Soil Chemistry',
    standard: 'Soil Science Society of America',
    definition:
      'The total quantity of negatively charged sites on soil clay minerals and organic matter capable of electrostatically holding exchangeable nutrient cations (Ca²⁺, Mg²⁺, K⁺, NH₄⁺) against leaching, expressed in cmol(+)/kg or meq/100 g. Humic substances exhibit exceptionally high CEC values of 200 to 500+ meq/100 g—often 5 to 20 times greater than silicate clays.',
    relatedSlug: '/origins/formation-and-shocking-facts',
    relatedLabel: 'Formation & Shocking Facts',
  },
  {
    id: 'chelation',
    term: 'Chelation (Metal Complexation)',
    category: 'Soil Chemistry',
    standard: 'IUPAC / IHSS',
    definition:
      'The formation of stable coordinate ring complexes in which multiple oxygen-containing functional groups (primarily adjacent carboxylate –COO⁻ and phenolic –OH ligands) on humic or fulvic molecules bind a central polyvalent metal ion such as Fe²⁺/³⁺, Zn²⁺, Mn²⁺, or Cu²⁺, keeping micronutrients bioavailable in alkaline or calcareous soils.',
    relatedSlug: '/agronomy/complete-application-and-tank-mix-guide',
    relatedLabel: 'Application & Tank-Mix Guide',
  },
  {
    id: 'colorimetric-assay',
    term: 'Colorimetric Assay',
    category: 'Analytical Standards',
    standard: 'Non-Standard Legacy Method',
    definition:
      'A rapid spectrophotometric technique that estimates humic content solely from light absorbance in the visible or ultraviolet range (commonly 400–600 nm). Because unrelated dark substances—such as sodium lignosulfonate, caramelized sugars, molasses, or synthetic dyes—also absorb strongly at these wavelengths, colorimetric methods are prone to severe inflation and are rejected by ISO 19822 and AAPFCO.',
    relatedSlug: '/quality-and-testing/market-malpractices-and-testing',
    relatedLabel: 'Market Malpractices & Testing',
  },
  {
    id: 'dax-8-resin',
    term: 'DAX-8 Resin (Superlite DAX-8)',
    abbr: 'DAX-8',
    category: 'Analytical Standards',
    standard: 'ISO 19822:2018 / IHSS',
    definition:
      'A non-ionic, macroporous polymethylmethacrylate (acrylic ester) adsorbent resin used in ISO 19822 (Lamar) and IHSS protocols to isolate genuine hydrophobic fulvic acid from non-humic water-soluble contaminants such as simple sugars, organic acids, and lignosulfonates at acidic pH (pH ≤ 1–2).',
    relatedSlug: '/quality-and-testing/market-malpractices-and-testing',
    relatedLabel: 'ISO 19822 & Quality Testing',
  },
  {
    id: 'electron-shuttling',
    term: 'Electron Shuttling (Redox Capacity)',
    category: 'Soil Chemistry',
    standard: 'Peer-Reviewed Soil Biogeochemistry',
    definition:
      'The reversible capacity of quinone and phenolic moieties embedded within humic substances to accept and donate electrons, acting as natural biogeochemical mediators between soil microorganisms and insoluble mineral electron acceptors such as Fe(III) and Mn(IV) oxides.',
    relatedSlug: '/origins/formation-and-shocking-facts',
    relatedLabel: 'Formation & Soil Chemistry',
  },
  {
    id: 'flocculation',
    term: 'Flocculation (Salting-Out / Divalent Bridging)',
    category: 'Agronomy',
    standard: 'Colloid & Interface Soil Chemistry',
    definition:
      'The aggregation and precipitation of dissolved humic acid colloids out of aqueous solution triggered either by strong acidification (protonation below pH 4–5) or by divalent/trivalent cations (especially Ca²⁺, Mg²⁺, Fe³⁺, Al³⁺) cross-linking negatively charged carboxylate sites across adjacent humic assemblies.',
    relatedSlug: '/tools/tank-mix-checker',
    relatedLabel: 'Tank-Mix Compatibility Checker',
  },
  {
    id: 'fulvic-acid',
    term: 'Fulvic Acid (FA)',
    abbr: 'FA',
    category: 'Soil Chemistry',
    standard: 'IHSS / ISO 19822:2018',
    definition:
      'The operationally defined fraction of humic substances that remains soluble in water across the entire pH spectrum (pH 1 to 14), including strongly acidic conditions. Fulvic acids possess lower apparent molecular weights (~500–2,000 Da), higher oxygen content, greater total acidity (carboxyl density), and superior foliar and hard-water mobility compared to humic acids.',
    relatedSlug: '/origins/formation-and-shocking-facts',
    relatedLabel: 'Humic vs. Fulvic vs. Humin',
  },
  {
    id: 'humic-acid',
    term: 'Humic Acid (HA)',
    abbr: 'HA',
    category: 'Soil Chemistry',
    standard: 'IHSS / ISO 19822:2018',
    definition:
      'The operationally defined fraction of humic substances that is insoluble in water under strongly acidic conditions (pH < 2) but soluble at neutral to alkaline pH. Rich in aromatic rings, phenolic hydroxyls, and carboxylic groups, humic acids primarily drive soil structural aggregation, water retention, cation exchange, and rhizosphere phosphorus mobilization.',
    relatedSlug: '/origins/formation-and-shocking-facts',
    relatedLabel: 'Formation & Chemistry Guide',
  },
  {
    id: 'humic-substances',
    term: 'Humic Substances (HS)',
    abbr: 'HS',
    category: 'Soil Chemistry',
    standard: 'IHSS',
    definition:
      'Complex, heterogeneous, dark-colored organic assemblies formed during the long-term microbial and abiotic transformation (humification) of plant and microbial biomolecules in soils, sediments, and natural waters. Operationally partitioned by aqueous solubility into humic acid, fulvic acid, and humin.',
    relatedSlug: '/origins/formation-and-shocking-facts',
    relatedLabel: 'Encyclopedia Overview',
  },
  {
    id: 'humification',
    term: 'Humification',
    category: 'Soil Chemistry',
    standard: 'Soil Organic Matter Science',
    definition:
      'The multi-stage biogeochemical transformation in which labile plant residues (cellulose, hemicellulose, lignin, proteins, lipids) undergo microbial decomposition, oxidative alteration, and molecular reorganization into chemically recalcitrant, oxygen-functionalized humic assemblies over years in soils or tens of millions of years in coal-bearing strata.',
    relatedSlug: '/origins/formation-and-shocking-facts',
    relatedLabel: '70-Million-Year Formation',
  },
  {
    id: 'humin',
    term: 'Humin',
    category: 'Soil Chemistry',
    standard: 'IHSS',
    definition:
      'The fraction of humic substances that is insoluble in water at all pH values (acidic, neutral, and alkaline). Tightly bound to soil clay minerals and composed largely of aliphatic hydrocarbon chains and condensed aromatic cores, humin represents the most persistent pool of soil organic carbon, contributing long-term structural stability and water holding.',
    relatedSlug: '/origins/formation-and-shocking-facts',
    relatedLabel: 'Humic vs. Fulvic vs. Humin',
  },
  {
    id: 'ihss',
    term: 'International Humic Substances Society (IHSS)',
    abbr: 'IHSS',
    category: 'Analytical Standards',
    standard: 'IHSS (Founded 1981)',
    definition:
      'The premier international scientific organization dedicated to advancing research on humic substances in soils, sediments, and waters. IHSS maintains globally recognized standard reference materials (such as Pahokee Peat and Leonardite Humic Acid) and standardized fractionation protocols.',
    relatedSlug: '/quality-and-testing/market-malpractices-and-testing',
    relatedLabel: 'Analytical Standards Guide',
  },
  {
    id: 'iso-19822',
    term: 'ISO 19822 (Lamar / HPTA Method)',
    abbr: 'ISO 19822:2018',
    category: 'Analytical Standards',
    standard: 'ISO 19822:2018',
    definition:
      'The internationally standardized gravimetric-and-resin analytical method developed by Dr. Richard Lamar and the Humic Products Trade Association (HPTA) for quantifying humic acid and hydrophobic fulvic acid in commercial fertilizers and biostimulants. It removes ash interference via combustion loss-on-ignition and separates true fulvic acid using DAX-8 resin, defeating common adulterants.',
    relatedSlug: '/quality-and-testing/market-malpractices-and-testing',
    relatedLabel: 'ISO 19822 vs. IHSS vs. CDFA',
  },
  {
    id: 'leonardite',
    term: 'Leonardite',
    category: 'Raw Materials',
    standard: 'Geological / Agronomic Classification',
    definition:
      'A naturally oxidized, soft, vitreous-to-dull brown-black lignite (low-rank coal) formed over 50–70 million years near the Earth’s surface where prolonged weathering enriched its humic acid concentration to 40–85% on a dry ash-free basis. Named after geologist A. G. Leonard of North Dakota, high-grade leonardite is the premier feedstock for agricultural potassium humate.',
    relatedSlug: '/raw-materials/raw-materials-and-extraction',
    relatedLabel: 'Leonardite vs. Lignite vs. Peat',
  },
  {
    id: 'potassium-humate',
    term: 'Potassium Humate',
    category: 'Raw Materials',
    standard: 'Agronomic Input Specification',
    definition:
      'The water-soluble potassium salt of humic acid produced by reacting oxidized leonardite with potassium hydroxide (KOH). Preferred over sodium humate in agriculture because it supplies plant-available potassium (typically 8–12% K₂O) without introducing sodium ions that disperse soil clay aggregates and elevate sodicity.',
    relatedSlug: '/raw-materials/raw-materials-and-extraction',
    relatedLabel: 'KOH vs. NaOH Extraction',
  },
  {
    id: 'sodium-lignosulfonate',
    term: 'Sodium Lignosulfonate',
    category: 'Analytical Standards',
    standard: 'Quality Control / Adulteration Marker',
    definition:
      'A low-cost, dark-brown water-soluble byproduct of the sulfite wood-pulping paper industry frequently used to adulterate commercial humic products. Unlike genuine leonardite humates (which typically contain <0.75% sulfur and low sodium), sodium lignosulfonate exhibits elevated elemental sulfur (>3–6% S), high sodium content, a faint woody/vanilla odor, and fails ISO 19822 acid precipitation.',
    relatedSlug: '/quality-and-testing/market-malpractices-and-testing',
    relatedLabel: 'Spotting 7 Market Malpractices',
  },
  {
    id: 'supramolecular-assembly',
    term: 'Supramolecular Assembly (Piccolo Model)',
    category: 'Soil Chemistry',
    standard: 'Piccolo (2001) Soil Science',
    definition:
      'The modern paradigm in soil chemistry demonstrating that humic substances are not single giant covalent macromolecules, but dynamic self-assembled associations of relatively small, heterogeneous organic molecules (200–2,000 Da) held together by weak non-covalent hydrophobic interactions, van der Waals forces, and hydrogen bonds—explaining their conformational flexibility in the rhizosphere.',
    relatedSlug: '/origins/formation-and-shocking-facts',
    relatedLabel: 'Supramolecular Soil Science',
  },
];

const sortedTerms = [...terms].sort((a, b) => a.term.localeCompare(b.term));
const letters = Array.from(new Set(sortedTerms.map((t) => t.term[0].toUpperCase()))).sort();

const siteUrl = 'https://humic.blog';
const glossaryUrl = `${siteUrl}/glossary`;

const definedTermSetNode = {
  '@type': 'DefinedTermSet',
  '@id': `${glossaryUrl}#termset`,
  name: 'Humic.blog A–Z Humic Science Glossary',
  description:
    'Standardized IHSS and ISO 19822 definitions covering humic substances, soil chemistry, analytical testing, raw materials, and agronomic application.',
  url: glossaryUrl,
  inLanguage: 'en',
  hasDefinedTerm: sortedTerms.map((t) => ({
    '@type': 'DefinedTerm',
    '@id': `${glossaryUrl}#${t.id}`,
    name: t.term,
    description: t.definition,
    url: `${glossaryUrl}#${t.id}`,
    inDefinedTermSet: `${glossaryUrl}#termset`,
    ...(t.abbr ? { termCode: t.abbr } : {}),
  })),
};

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: 'A–Z Humic Science Glossary', url: glossaryUrl },
];
---

<BaseLayout
  title="A–Z Humic Science Glossary (IHSS & ISO 19822 Standardized Definitions)"
  description="Comprehensive A–Z glossary of 18 standardized IHSS and ISO 19822 humic science terms including CEC, chelation, DAX-8 resin, fulvic acid, humic acid, humin, leonardite, sodium lignosulfonate, and supramolecular assembly."
  canonicalPath="/glossary"
  schemaType="glossary"
  breadcrumbs={breadcrumbs}
  extraSchemaNodes={[definedTermSetNode]}
>
  <div class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div data-pagefind-body class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
      <nav aria-label="Breadcrumb" class="mb-3 text-xs text-emerald-300 flex items-center gap-1.5">
        <a href="/" class="hover:text-amber-400">Home</a>
        <span>/</span>
        <span class="text-emerald-100">A–Z Glossary</span>
      </nav>
      <span class="inline-flex items-center rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-0.5 text-xs font-semibold text-amber-300 mb-3">
        IHSS &amp; ISO 19822 Reference Vocabulary
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white leading-tight">
        A–Z Humic Science Glossary
      </h1>
      <p class="mt-3 text-sm sm:text-base text-emerald-100/90 max-w-3xl leading-relaxed">
        {sortedTerms.length} standardized, peer-reviewed definitions spanning soil colloid chemistry, international analytical protocols, raw material geology, and field agronomy.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-8">
    <!-- Filter & A-Z Bar -->
    <section aria-label="Glossary Filter Controls" class="rounded-2xl bg-white border border-slate-200 p-5 shadow-xs space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
        <div class="sm:col-span-7">
          <label for="glossary-search" class="sr-only">Search glossary terms</label>
          <input
            id="glossary-search"
            type="search"
            placeholder="Search terms, standards, or definitions (e.g. DAX-8, sulfur, CEC)..."
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-emerald-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-800/20"
          />
        </div>
        <div class="sm:col-span-5">
          <label for="glossary-category" class="sr-only">Filter by category</label>
          <select
            id="glossary-category"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-800/20"
          >
            <option value="all">All Categories ({sortedTerms.length})</option>
            <option value="Soil Chemistry">Soil Chemistry</option>
            <option value="Analytical Standards">Analytical Standards</option>
            <option value="Raw Materials">Raw Materials</option>
            <option value="Agronomy">Agronomy</option>
          </select>
        </div>
      </div>

      <!-- A-Z Jump Links -->
      <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-slate-100">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mr-1">Jump:</span>
        {letters.map((letter) => (
          <a
            href={`#letter-${letter}`}
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 hover:bg-emerald-900 hover:text-amber-400 text-xs font-bold text-emerald-950 transition-colors"
          >
            {letter}
          </a>
        ))}
        <span id="glossary-count" class="ml-auto text-xs font-medium text-slate-500">
          Showing {sortedTerms.length} of {sortedTerms.length} terms
        </span>
      </div>
    </section>

    <!-- Terms List -->
    <div id="glossary-list" class="space-y-4">
      {letters.map((letter) => {
        const group = sortedTerms.filter((t) => t.term[0].toUpperCase() === letter);
        return (
          <section id={`letter-${letter}`} data-letter-group={letter} class="scroll-mt-24 space-y-3">
            <div class="flex items-center gap-3 pt-2">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-950 font-serif text-lg font-bold text-amber-400 shadow-xs">
                {letter}
              </span>
              <div class="h-px flex-1 bg-slate-200" aria-hidden="true"></div>
            </div>

            {group.map((item) => (
              <article
                id={item.id}
                data-term-card
                data-category={item.category}
                data-search={`${item.term} ${item.abbr ?? ''} ${item.standard} ${item.definition}`.toLowerCase()}
                class="scroll-mt-24 rounded-2xl bg-white border border-slate-200 p-6 shadow-xs hover:border-emerald-800/40 transition-colors"
              >
                <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                  <h2 class="font-serif text-xl font-bold text-emerald-950 m-0">
                    {item.term}
                  </h2>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="inline-flex items-center rounded-full bg-emerald-950/5 border border-emerald-900/15 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-900">
                      {item.category}
                    </span>
                    <span class="inline-flex items-center rounded-full bg-amber-500/15 border border-amber-500/30 px-2.5 py-0.5 text-[11px] font-semibold text-amber-900">
                      {item.standard}
                    </span>
                  </div>
                </div>

                <p class="text-sm sm:text-[0.96rem] text-slate-700 leading-relaxed m-0">
                  {item.definition}
                </p>

                {item.relatedSlug && (
                  <div class="mt-3 pt-3 border-t border-slate-100">
                    <a
                      href={item.relatedSlug}
                      class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2"
                    >
                      Related Deep Dive: {item.relatedLabel} &rarr;
                    </a>
                  </div>
                )}
              </article>
            ))}
          </section>
        );
      })}
    </div>

    <p id="glossary-empty" class="hidden rounded-2xl bg-white border border-slate-200 p-8 text-center text-sm text-slate-600">
      No glossary definitions matched your filter. Try clearing the search box or switching categories.
    </p>
  </div>

  <script is:inline>
    (function () {
      const searchInput = document.getElementById('glossary-search');
      const catSelect = document.getElementById('glossary-category');
      const cards = Array.from(document.querySelectorAll('[data-term-card]'));
      const groups = Array.from(document.querySelectorAll('[data-letter-group]'));
      const countEl = document.getElementById('glossary-count');
      const emptyEl = document.getElementById('glossary-empty');
      const total = cards.length;

      function filterGlossary() {
        const q = (searchInput.value || '').trim().toLowerCase();
        const cat = catSelect.value;
        let visible = 0;

        cards.forEach(function (card) {
          const matchesCat = cat === 'all' || card.getAttribute('data-category') === cat;
          const matchesQuery = !q || (card.getAttribute('data-search') || '').includes(q);
          const show = matchesCat && matchesQuery;
          card.classList.toggle('hidden', !show);
          if (show) visible++;
        });

        groups.forEach(function (group) {
          const anyVisible = group.querySelector('[data-term-card]:not(.hidden)') !== null;
          group.classList.toggle('hidden', !anyVisible);
        });

        countEl.textContent = 'Showing ' + visible + ' of ' + total + ' terms';
        emptyEl.classList.toggle('hidden', visible > 0);
      }

      searchInput.addEventListener('input', filterGlossary);
      catSelect.addEventListener('change', filterGlossary);
    })();
  </script>
</BaseLayout>
