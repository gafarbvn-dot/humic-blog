---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CanonicalAnswer from '../../components/CanonicalAnswer.astro';
import { PILLAR_LIST, type PillarDefinition } from '../../lib/pillars';

export async function getStaticPaths() {
  return PILLAR_LIST.map((pillar) => ({
    params: { pillar: pillar.slug },
    props: { pillar },
  }));
}

interface Props {
  pillar: PillarDefinition;
}

const { pillar } = Astro.props;
const allArticles = await getCollection('articles');
const articles = allArticles
  .filter((a) => a.data.pillar === pillar.name)
  .sort((a, b) => Number(b.data.isPillarPage) - Number(a.data.isPillarPage));

const siteUrl = 'https://humic.blog';
const canonicalPath = `/${pillar.slug}`;

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: pillar.name, url: `${siteUrl}${canonicalPath}` },
];
---

<BaseLayout
  title={`${pillar.name} — Humic Substances Pillar Hub`}
  description={pillar.subtitle}
  canonicalPath={canonicalPath}
  schemaType="collection"
  pillar={pillar.name}
  breadcrumbs={breadcrumbs}
>
  <div class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <nav aria-label="Breadcrumb" class="mb-3 text-xs text-emerald-300 flex items-center gap-1.5">
        <a href="/" class="hover:text-amber-400">Home</a>
        <span>/</span>
        <span class="text-emerald-100">{pillar.name}</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="inline-flex items-center rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-0.5 text-xs font-semibold text-amber-300">
          {pillar.code}
        </span>
        <span class="inline-flex items-center rounded-full bg-emerald-900 border border-emerald-700 px-3 py-0.5 text-xs font-medium text-emerald-100">
          {pillar.audience}
        </span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white leading-tight">
        {pillar.name}
      </h1>
      <p class="mt-3 text-sm sm:text-base text-emerald-100/90 max-w-3xl leading-relaxed">
        {pillar.subtitle}
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-xs">
      <CanonicalAnswer answer={pillar.canonicalSummary} />

      <div class="mt-6 flex items-center justify-between border-b border-slate-200 pb-3">
        <h2 class="font-serif text-2xl font-bold text-emerald-950">
          Published Guides ({articles.length})
        </h2>
        <a href="/" class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2">
          All 9 Pillars &rarr;
        </a>
      </div>

      <div class="divide-y divide-slate-200 mt-2">
        {articles.map((article) => {
          const words = article.body.trim().split(/\s+/).filter(Boolean).length;
          const readMin = Math.max(4, Math.ceil(words / 220));
          return (
            <article class="py-6">
              <div class="flex flex-wrap items-center gap-2 text-xs mb-2">
                {article.data.isPillarPage && (
                  <span class="inline-flex items-center rounded-full bg-amber-500/15 border border-amber-500/40 px-2.5 py-0.5 font-semibold text-amber-800">
                    Cornerstone Pillar Guide
                  </span>
                )}
                <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 font-medium text-slate-700">
                  {article.data.audience}
                </span>
                <span class="text-slate-500">{readMin} min read</span>
                <span class="text-slate-300">&bull;</span>
                <span class="text-slate-500">{article.data.citations.length} Citations</span>
              </div>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-emerald-950">
                <a
                  href={`/${article.slug}`}
                  class="hover:text-emerald-700 underline decoration-transparent hover:decoration-amber-500 underline-offset-4 transition-colors"
                >
                  {article.data.title}
                </a>
              </h3>
              <p class="mt-2 text-sm text-slate-700 leading-relaxed">
                {article.data.canonicalAnswer}
              </p>
              <div class="mt-3">
                <a
                  href={`/${article.slug}`}
                  class="inline-flex items-center gap-1 text-xs font-bold text-emerald-900 hover:text-amber-700 transition-colors"
                >
                  Read Complete Technical Guide &rarr;
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <!-- Cross-Pillar Navigation -->
    <section class="rounded-2xl bg-emerald-950 text-white p-6 sm:p-8">
      <div class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-3">
        Explore Other Knowledge Pillars
      </div>
      <div class="flex flex-wrap gap-2">
        {PILLAR_LIST.filter((p) => p.slug !== pillar.slug).map((other) => (
          <a
            href={`/${other.slug}`}
            class="rounded-lg bg-emerald-900 hover:bg-emerald-800 border border-emerald-800 px-3 py-2 text-xs font-semibold text-emerald-100 hover:text-amber-300 transition-colors"
          >
            {other.name}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
