interface CropRow {
  crop: string;
  category:
    | 'Row Crops & Cereals'
    | 'Orchards & Fruits'
    | 'Vegetables'
    | 'Cash & Plantation Crops'
    | 'Protected & Hydroponics';
  soilHa: string;
  soilAcre: string;
  dripHa: string;
  dripAcre: string;
  foliar: string;
  timing: string;
}

