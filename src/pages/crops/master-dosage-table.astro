import BaseLayout from '../../layouts/BaseLayout.astro';
import CanonicalAnswer from '../../components/CanonicalAnswer.astro';

const siteUrl = 'https://humic.blog';
const canonicalPath = '/crops/master-dosage-table';
const fullUrl = `${siteUrl}${canonicalPath}`;

