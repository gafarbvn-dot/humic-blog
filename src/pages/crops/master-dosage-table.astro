---

<BaseLayout
  title="30-Crop Master Humic & Fulvic Acid Dosage Table (Per Acre & Per Hectare)"
  description="Interactive 30-crop agronomic dosage matrix for Potassium Humate (70–80%) and Potassium Fulvate: instant search, category filters, Per Acre / Per Hectare toggle, soil, drip, and foliar timing windows."
  canonicalPath={canonicalPath}
  schemaType="article"
  pillar="Crops & Field Guides"
  pubDate={new Date('2026-11-20')}
  updatedDate={new Date('2026-11-20')}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  citations={citations}
  extraSchemaNodes={[datasetNode]}
>
  <div class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <nav aria-label="Breadcrumb" class="mb-3 text-xs text-emerald-300 flex items-center gap-1.5">
        <a href="/" class="hover:text-amber-400">Home</a>
        <span>/</span>
        <a href="/crops" class="hover:text-amber-400">Crops &amp; Field Guides</a>
        <span>/</span>
        <span class="text-emerald-100">30-Crop Master Dosage Matrix</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="inline-flex items-center rounded-full bg-amber-500/20 border border-amber-500/40 px-3 py-0.5 text-xs font-semibold text-amber-300">
          30 Global Crops &bull; Open Agronomic Dataset
        </span>
        <span class="inline-flex items-center rounded-full bg-emerald-900 border border-emerald-700 px-3 py-0.5 text-xs font-medium text-emerald-100">
          Calibrated for 70–80% ISO 19822 Potassium Humate
        </span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white leading-tight max-w-4xl">
        30-Crop Master Humic &amp; Fulvic Acid Dosage Matrix
      </h1>
      <p class="mt-3 text-sm sm:text-base text-emerald-100/90 max-w-3xl leading-relaxed">
        Search and filter field-tested basal, drip fertigation, and foliar spray dosing schedules across 30 major world crops. Toggle instantly between <strong>Per Hectare</strong> and <strong>Per Acre</strong> units, or calculate exact tank volumes in our <a href="/tools/dosage-calculator" class="text-amber-300 underline underline-offset-2 hover:text-amber-200">Dosage Calculator</a>.
      </p>
    </div>
  </div>

  <div data-pagefind-body class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <CanonicalAnswer answer={canonicalAnswer} />

    <!-- Filter, Search & Unit Control Bar -->
    <section aria-label="Dosage Matrix Controls" class="rounded-2xl bg-white border border-slate-200 p-5 shadow-xs space-y-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
          <label for="crop-search" class="sr-only">Search crop name</label>
          <input
            id="crop-search"
            type="search"
            placeholder="Search crop (e.g., Sugarcane, Mango, Tomato, Oil Palm)..."
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-emerald-800 focus:bg-white focus:outline-none"
          />
        </div>

        <!-- Unit Toggle -->
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Area Unit:</span>
          <div class="inline-flex rounded-xl border border-slate-300 bg-slate-100 p-1" role="group" aria-label="Area Unit Toggle">
            <button
              type="button"
              data-unit="ha"
              class="unit-btn rounded-lg px-3.5 py-1.5 text-xs font-bold bg-emerald-950 text-white shadow-xs transition-colors cursor-pointer"
            >
              Per Hectare
            </button>
            <button
              type="button"
              data-unit="acre"
              class="unit-btn rounded-lg px-3.5 py-1.5 text-xs font-bold text-slate-700 hover:text-emerald-950 transition-colors cursor-pointer"
            >
              Per Acre
            </button>
          </div>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-1" role="group" aria-label="Crop Category Filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-cat={cat}
            class:list={[
              'cat-btn rounded-full px-3.5 py-1.5 text-xs font-semibold border transition-colors cursor-pointer',
              idx === 0
                ? 'bg-emerald-950 text-amber-300 border-emerald-950'
                : 'bg-white text-slate-700 border-slate-300 hover:border-emerald-800 hover:text-emerald-950',
            ]}
          >
            {cat}
          </button>
        ))}
        <span id="crop-count-label" class="ml-auto text-xs font-semibold text-slate-500">
          Showing 30 of 30 crops
        </span>
      </div>
    </section>

    <!-- 30-Crop Responsive Data Table -->
    <section aria-label="30-Crop Master Dosage Table" class="rounded-2xl bg-white border border-slate-200 shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-emerald-950 text-white border-b-2 border-amber-500">
              <th class="px-4 py-3.5 font-semibold whitespace-nowrap">Crop &amp; Category</th>
              <th class="px-4 py-3.5 font-semibold whitespace-nowrap">
                Soil / Basal Rate <span class="unit-header-tag text-amber-300 font-normal">(Per Hectare)</span>
              </th>
              <th class="px-4 py-3.5 font-semibold whitespace-nowrap">
                Drip Fertigation <span class="unit-header-tag text-amber-300 font-normal">(Per Hectare)</span>
              </th>
              <th class="px-4 py-3.5 font-semibold whitespace-nowrap">Foliar Spray (g/L)</th>
              <th class="px-4 py-3.5 font-semibold">Key Physiological Timing Windows</th>
            </tr>
          </thead>
          <tbody id="crop-table-body" class="divide-y divide-slate-200">
            {crops.map((row) => (
              <tr
                class="crop-row hover:bg-emerald-50/60 transition-colors"
                data-crop={row.crop.toLowerCase()}
                data-category={row.category}
              >
                <td class="px-4 py-3.5 align-top">
                  <div class="font-bold text-emerald-950">{row.crop}</div>
                  <span class="mt-1 inline-block rounded-full bg-slate-100 border border-slate-200 px-2 py-0.5 text-[10px] font-semibold text-slate-600">
                    {row.category}
                  </span>
                </td>
                <td
                  class="px-4 py-3.5 align-top font-semibold text-slate-900 whitespace-nowrap cell-soil"
                  data-ha={row.soilHa}
                  data-acre={row.soilAcre}
                >
                  {row.soilHa}
                </td>
                <td
                  class="px-4 py-3.5 align-top font-semibold text-emerald-900 whitespace-nowrap cell-drip"
                  data-ha={row.dripHa}
                  data-acre={row.dripAcre}
                >
                  {row.dripHa}
                </td>
                <td class="px-4 py-3.5 align-top text-slate-800 whitespace-nowrap">{row.foliar}</td>
                <td class="px-4 py-3.5 align-top text-slate-700 leading-relaxed min-w-[240px]">{row.timing}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div id="crop-empty-state" class="hidden p-8 text-center text-sm text-slate-600">
        No crops match your current search or category filter. Clear the search box or select <strong>All</strong>.
      </div>
    </section>

    <!-- Cross-Links CTA Strip -->
    <section class="rounded-2xl bg-emerald-950 text-white p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-5">
      <div class="space-y-1.5 max-w-2xl">
        <div class="text-xs font-bold uppercase tracking-wider text-amber-400">Next Step: Exact Tank Volumes &amp; Printable Charts</div>
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-white m-0">
          Need Custom Acreage Math or 1-Page Field Reference Sheets?
        </h2>
        <p class="text-sm text-emerald-100/90 m-0">
          Convert these rates for liquid concentrates (12–15% HA) in our Dosage Calculator, check tank-mix safety with Calcium Nitrate, or print ink-friendly 1-page cheat sheets for your farm crew.
        </p>
      </div>
      <div class="flex flex-wrap gap-2.5 shrink-0">
        <a href="/tools/dosage-calculator" class="rounded-lg bg-amber-500 hover:bg-amber-400 px-4 py-2.5 text-xs font-bold text-emerald-950 transition-colors">
          Dosage Calculator &rarr;
        </a>
        <a href="/tools/tank-mix-checker" class="rounded-lg bg-emerald-900 hover:bg-emerald-800 border border-emerald-700 px-4 py-2.5 text-xs font-semibold text-white transition-colors">
          Tank-Mix Checker &rarr;
        </a>
        <a href="/field-sheets" class="rounded-lg bg-white/10 hover:bg-white/20 border border-white/20 px-4 py-2.5 text-xs font-semibold text-white transition-colors">
          Printable Field Sheets &rarr;
        </a>
      </div>
    </section>

    <!-- FAQs -->
    <section class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-xs">
      <h2 class="font-serif text-2xl font-bold text-emerald-950 mb-4">Dosage Matrix FAQs</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="rounded-xl border border-slate-200 p-4 open:bg-slate-50">
            <summary class="font-semibold text-slate-900 cursor-pointer text-sm sm:text-base">{faq.question}</summary>
            <p class="mt-2.5 text-sm text-slate-700 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Scientific References -->
    <section class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-xs">
      <h2 class="font-serif text-xl font-bold text-emerald-950 mb-3">Scientific References &amp; Standards</h2>
      <ul class="space-y-2.5 text-sm text-slate-700">
        {citations.map((c) => (
          <li class="leading-relaxed">
            <strong class="text-slate-900">{c.title}.</strong> {c.source}.{' '}
            {c.url && (
              <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-emerald-800 underline decoration-amber-500 underline-offset-2 font-medium">
                Source / DOI &#8599;
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <script is:inline>
    (function () {
      var searchInput = document.getElementById('crop-search');
      var catBtns = Array.prototype.slice.call(document.querySelectorAll('.cat-btn'));
      var unitBtns = Array.prototype.slice.call(document.querySelectorAll('.unit-btn'));
      var rows = Array.prototype.slice.call(document.querySelectorAll('.crop-row'));
      var countLabel = document.getElementById('crop-count-label');
      var emptyState = document.getElementById('crop-empty-state');
      var unitHeaderTags = Array.prototype.slice.call(document.querySelectorAll('.unit-header-tag'));

      var activeCat = 'All';
      var activeUnit = 'ha';
      var searchTimer = null;

      function pushTrack(detail) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'humic_tool_interaction',
          tool_name: 'master_dosage_table',
          action_detail: detail,
        });
      }

      function render() {
        var q = (searchInput.value || '').trim().toLowerCase();
        var visible = 0;

        rows.forEach(function (tr) {
          var cropName = tr.getAttribute('data-crop') || '';
          var cat = tr.getAttribute('data-category') || '';
          var matchesCat = activeCat === 'All' || cat === activeCat;
          var matchesQuery = !q || cropName.indexOf(q) !== -1 || cat.toLowerCase().indexOf(q) !== -1;

          if (matchesCat && matchesQuery) {
            tr.classList.remove('hidden');
            visible++;
          } else {
            tr.classList.add('hidden');
          }

          var soilCell = tr.querySelector('.cell-soil');
          var dripCell = tr.querySelector('.cell-drip');
          if (soilCell) soilCell.textContent = soilCell.getAttribute('data-' + activeUnit);
          if (dripCell) dripCell.textContent = dripCell.getAttribute('data-' + activeUnit);
        });

        unitHeaderTags.forEach(function (el) {
          el.textContent = activeUnit === 'ha' ? '(Per Hectare)' : '(Per Acre)';
        });

        countLabel.textContent = 'Showing ' + visible + ' of ' + rows.length + ' crops';
        if (visible === 0) emptyState.classList.remove('hidden');
        else emptyState.classList.add('hidden');
      }

      catBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeCat = btn.getAttribute('data-cat') || 'All';
          catBtns.forEach(function (b) {
            var isAct = b === btn;
            b.className = isAct
              ? 'cat-btn rounded-full px-3.5 py-1.5 text-xs font-semibold border transition-colors cursor-pointer bg-emerald-950 text-amber-300 border-emerald-950'
              : 'cat-btn rounded-full px-3.5 py-1.5 text-xs font-semibold border transition-colors cursor-pointer bg-white text-slate-700 border-slate-300 hover:border-emerald-800 hover:text-emerald-950';
          });
          render();
          pushTrack('category:' + activeCat + '|unit:' + activeUnit);
        });
      });

      unitBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeUnit = btn.getAttribute('data-unit') || 'ha';
          unitBtns.forEach(function (b) {
            var isAct = b === btn;
            b.className = isAct
              ? 'unit-btn rounded-lg px-3.5 py-1.5 text-xs font-bold bg-emerald-950 text-white shadow-xs transition-colors cursor-pointer'
              : 'unit-btn rounded-lg px-3.5 py-1.5 text-xs font-bold text-slate-700 hover:text-emerald-950 transition-colors cursor-pointer';
          });
          render();
          pushTrack('unit:' + activeUnit + '|category:' + activeCat);
        });
      });

      searchInput.addEventListener('input', function () {
        render();
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () {
          if (searchInput.value.trim()) {
            pushTrack('search:' + searchInput.value.trim().slice(0, 30));
          }
        }, 500);
      });
    })();
  </script>
</BaseLayout>
