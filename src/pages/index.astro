---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PILLARS } from '../content/config';

const allArticles = await getCollection('articles');

const pillarMeta: Record<string, { subtitle: string; code: string }> = {
  'Origins & Chemistry': {
    code: 'PILLAR 01',
    subtitle: 'Geological formation of leonardite, supramolecular soil chemistry, and the distinction between humic acid, fulvic acid, and humin.',
  },
  'Raw Materials & Extraction': {
    code: 'PILLAR 02',
    subtitle: 'Source comparison from leonardite to peat and compost, alkaline KOH vs. NaOH chemistry, and salinity implications.',
  },
  'Quality & Testing': {
    code: 'PILLAR 03',
    subtitle: 'Analytical verification under ISO 19822 and IHSS protocols, spotting sodium lignosulfonate adulteration, and avoiding colorimetric inflation.',
  },
  'Agronomy & Application': {
    code: 'PILLAR 04',
    subtitle: 'Precision field protocols across drip fertigation, soil broadcast, foliar sprays, seed treatments, crop calendars, and critical precautions.',
  },
  'Biostimulant Synergies': {
    code: 'PILLAR 05',
    subtitle: 'Physiological and rhizosphere interactions between humic substances, Ascophyllum nodosum kelp extracts, and enzymatic L-amino acids.',
  },
  'Regulations & Organic Standards': {
    code: 'PILLAR 06',
    subtitle: 'Worldwide agricultural compliance frameworks including USDA NOP/OMRI, EU FPR 2019/1009, US AAPFCO/CDFA, and India FCO/NPOP.',
  },
  'Soil Health & Sustainability': {
    code: 'PILLAR 07',
    subtitle: 'Nutrient use efficiency, waterway protection, mycorrhizal biodiversity, and degraded-land restoration for long-term food security.',
  },
};

const grouped = PILLARS.map((pillar) => {
  const items = allArticles
    .filter((a) => a.data.pillar === pillar)
    .sort((a, b) => Number(b.data.isPillarPage) - Number(a.data.isPillarPage));
  return {
    pillar,
    meta: pillarMeta[pillar],
    articles: items,
  };
}).filter((g) => g.articles.length > 0);
---

<BaseLayout
  title="Humic.blog — The Authoritative Educational Encyclopedia on Humic Substances"
  description="A vendor-neutral, peer-reviewed soil science encyclopedia covering humic acid, fulvic acid, leonardite extraction, ISO 19822 testing, agronomy calculators, and global organic regulations."
  canonicalPath="/"
  schemaType="website"
  breadcrumbs={[{ name: 'Home', url: 'https://humic.blog' }]}
>
  <!-- Editorial Hero -->
  <section class="bg-emerald-950 text-white border-b-4 border-amber-500">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-900/90 border border-emerald-700/70 px-3.5 py-1 text-xs font-semibold tracking-wide text-amber-400 mb-5">
          <span class="h-2 w-2 rounded-full bg-amber-400" aria-hidden="true"></span>
          Independent &bull; Vendor-Neutral &bull; IHSS &amp; ISO 19822 Aligned
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-[3.35rem] font-bold tracking-tight text-white leading-[1.12]">
          The Global Encyclopedia of <span class="text-amber-400">Humic Substances</span>
        </h1>

        <p class="mt-5 text-base sm:text-lg text-emerald-100/90 leading-relaxed max-w-3xl">
          Evidence-based soil chemistry, analytical testing standards, and precision agronomic protocols for humic acid, fulvic acid, and humin—authored without commercial bias for agronomists, researchers, growers, and agricultural policymakers.
        </p>

        <div class="mt-8 flex flex-wrap gap-3.5">
          <a
            href="#encyclopedia"
            class="inline-flex items-center justify-center rounded-xl bg-amber-500 hover:bg-amber-400 px-5 py-3 text-sm font-bold text-emerald-950 shadow-sm transition-colors"
          >
            Explore Knowledge Pillars &darr;
          </a>
          <a
            href="/tools/dosage-calculator"
            class="inline-flex items-center justify-center rounded-xl bg-emerald-900 hover:bg-emerald-800 border border-emerald-700 px-5 py-3 text-sm font-semibold text-white transition-colors"
          >
            Dosage Calculator
          </a>
          <a
            href="/tools/tank-mix-checker"
            class="inline-flex items-center justify-center rounded-xl bg-emerald-900 hover:bg-emerald-800 border border-emerald-700 px-5 py-3 text-sm font-semibold text-white transition-colors"
          >
            Tank-Mix Checker
          </a>
          <a
            href="/glossary"
            class="inline-flex items-center justify-center rounded-xl bg-transparent hover:bg-emerald-900/60 border border-emerald-600/80 px-5 py-3 text-sm font-semibold text-emerald-100 transition-colors"
          >
            A–Z Glossary
          </a>
        </div>
      </div>

      <!-- Authority Stats -->
      <div class="mt-12 pt-8 border-t border-emerald-900 grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div>
          <div class="font-serif text-2xl sm:text-3xl font-bold text-amber-400">{allArticles.length}</div>
          <div class="text-xs sm:text-sm text-emerald-200 mt-0.5">Cornerstone Technical Guides</div>
        </div>
        <div>
          <div class="font-serif text-2xl sm:text-3xl font-bold text-amber-400">ISO 19822</div>
          <div class="text-xs sm:text-sm text-emerald-200 mt-0.5">Lamar &amp; IHSS Referenced</div>
        </div>
        <div>
          <div class="font-serif text-2xl sm:text-3xl font-bold text-amber-400">2 Tools</div>
          <div class="text-xs sm:text-sm text-emerald-200 mt-0.5">Zero-Latency Field Calculators</div>
        </div>
        <div>
          <div class="font-serif text-2xl sm:text-3xl font-bold text-amber-400">18 Terms</div>
          <div class="text-xs sm:text-sm text-emerald-200 mt-0.5">Standardized A–Z Definitions</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Tools & Reference Strip -->
  <section aria-label="Interactive Agronomic Tools and Glossary" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 -mt-7 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href="/tools/dosage-calculator"
        class="group rounded-2xl bg-white border border-slate-200 hover:border-amber-500 p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center rounded-md bg-emerald-950 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-400">
              Interactive Tool
            </span>
            <span class="text-emerald-900 group-hover:translate-x-1 transition-transform font-bold">&rarr;</span>
          </div>
          <h2 class="font-serif text-xl font-bold text-emerald-950 group-hover:text-emerald-800">
            Humate &amp; Fulvic Dosage Calculator
          </h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Calculate field application rates for drip fertigation, soil broadcast, foliar spray, and seed treatment in acres or hectares.
          </p>
        </div>
      </a>

      <a
        href="/tools/tank-mix-checker"
        class="group rounded-2xl bg-white border border-slate-200 hover:border-amber-500 p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center rounded-md bg-emerald-950 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-400">
              Chemistry Safety
            </span>
            <span class="text-emerald-900 group-hover:translate-x-1 transition-transform font-bold">&rarr;</span>
          </div>
          <h2 class="font-serif text-xl font-bold text-emerald-950 group-hover:text-emerald-800">
            Tank-Mix Compatibility Checker
          </h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Instant Green/Amber/Red screening for mixing Potassium Humate with Calcium Nitrate, acids, NPK, seaweed, L-amino acids, and MgSO₄.
          </p>
        </div>
      </a>

      <a
        href="/glossary"
        class="group rounded-2xl bg-white border border-slate-200 hover:border-amber-500 p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center rounded-md bg-amber-500/15 border border-amber-500/30 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-800">
              Reference Index
            </span>
            <span class="text-emerald-900 group-hover:translate-x-1 transition-transform font-bold">&rarr;</span>
          </div>
          <h2 class="font-serif text-xl font-bold text-emerald-950 group-hover:text-emerald-800">
            A–Z Humic Science Glossary
          </h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Standardized IHSS and ISO 19822 definitions covering CEC, chelation, DAX-8 resin, leonardite, sodium lignosulfonate, and supramolecular assembly.
          </p>
        </div>
      </a>
    </div>
  </section>

  <!-- Encyclopedia Pillars Directory -->
  <section id="encyclopedia" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 sm:py-16 scroll-mt-16">
    <div class="max-w-3xl mb-10">
      <div class="text-xs font-bold uppercase tracking-widest text-amber-600 mb-2">
        Structured Knowledge Architecture
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-emerald-950">
        Encyclopedia by Scientific Pillar
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Every guide includes a canonical 45–60 word technical summary, comparative data tables, structured field FAQs, and citations to peer-reviewed soil science journals and international analytical standards.
      </p>
    </div>

    <div class="space-y-10">
      {grouped.map(({ pillar, meta, articles }) => (
        <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-xs">
          <div class="bg-slate-50 border-b border-slate-200 px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-widest text-amber-600">
                {meta.code}
              </span>
              <h3 class="font-serif text-2xl font-bold text-emerald-950 mt-0.5">
                {pillar}
              </h3>
              <p class="text-sm text-slate-600 mt-1 max-w-3xl">{meta.subtitle}</p>
            </div>
            <span class="self-start sm:self-center inline-flex items-center rounded-full bg-emerald-950/5 border border-emerald-900/15 px-3 py-1 text-xs font-semibold text-emerald-900 whitespace-nowrap">
              {articles.length} {articles.length === 1 ? 'Guide' : 'Guides'}
            </span>
          </div>

          <div class="divide-y divide-slate-200">
            {articles.map((article) => {
              const wordCount = article.body.trim().split(/\s+/).filter(Boolean).length;
              const readMin = Math.max(4, Math.ceil(wordCount / 220));
              return (
                <article class="p-6 hover:bg-emerald-950/[0.015] transition-colors">
                  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
                    <div class="space-y-2 max-w-4xl">
                      <div class="flex flex-wrap items-center gap-2 text-xs">
                        {article.data.isPillarPage && (
                          <span class="inline-flex items-center rounded-full bg-amber-500/15 border border-amber-500/40 px-2.5 py-0.5 font-semibold text-amber-800">
                            Cornerstone Pillar Guide
                          </span>
                        )}
                        <span class="text-slate-500 font-medium">{readMin} min read</span>
                        <span class="text-slate-300">&bull;</span>
                        <span class="text-slate-500">{article.data.citations.length} Scientific Citations</span>
                      </div>

                      <h4 class="font-serif text-xl sm:text-2xl font-bold text-emerald-950 leading-snug">
                        <a
                          href={`/${article.slug}`}
                          class="hover:text-emerald-700 underline decoration-transparent hover:decoration-amber-500 underline-offset-4 transition-colors"
                        >
                          {article.data.title}
                        </a>
                      </h4>

                      <p class="text-sm sm:text-[0.95rem] text-slate-700 leading-relaxed">
                        {article.data.canonicalAnswer}
                      </p>
                    </div>

                    <div class="lg:pt-5 shrink-0">
                      <a
                        href={`/${article.slug}`}
                        class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-900 hover:bg-emerald-950 px-4 py-2.5 text-xs font-semibold text-white transition-colors"
                      >
                        Read Full Guide <span aria-hidden="true">&rarr;</span>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Editorial Standards Banner -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-6">
    <div class="rounded-2xl bg-emerald-950 text-white p-8 sm:p-10 border border-emerald-900">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        <div class="lg:col-span-1">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-400">
            Editorial Methodology
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-1.5">
            Rigorous, Diplomatic, Vendor-Neutral Soil Science
          </h2>
        </div>
        <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm text-emerald-100/90 leading-relaxed">
          <div class="space-y-1.5">
            <h3 class="font-sans text-sm font-bold text-amber-400">Standardized Analytical Grounding</h3>
            <p>
              All concentration metrics, extraction comparisons, and adulteration checks reference ISO 19822:2018 (Lamar), IHSS fractionation protocols, and peer-reviewed soil chemistry literature rather than unverified commercial assays.
            </p>
          </div>
          <div class="space-y-1.5">
            <h3 class="font-sans text-sm font-bold text-amber-400">Legally Compliant Agronomic Scope</h3>
            <p>
              Guidance focuses strictly on documented soil conditioning, cation exchange capacity, nutrient use efficiency, and plant tolerance to abiotic stress—never unverified pesticidal or medicinal claims.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
