---
export interface Props {
  isEmbed?: boolean;
}

const { isEmbed = false } = Astro.props;
const linkTarget = isEmbed ? '_blank' : undefined;
const linkRel = isEmbed ? 'noopener' : undefined;
---

<div data-humic-widget="blend-ph-estimator" data-is-embed={isEmbed ? 'true' : 'false'} class={isEmbed ? 'space-y-4' : 'space-y-6'}>
    <div class={isEmbed ? "grid grid-cols-1 md:grid-cols-12 gap-4 items-start" : "grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"}>
      <!-- Inputs -->
      <section aria-label="Blend Parameters" class={isEmbed ? "md:col-span-6 rounded-2xl bg-white border border-slate-200 p-4 sm:p-5 shadow-xs space-y-5" : "lg:col-span-6 rounded-2xl bg-white border border-slate-200 p-6 sm:p-7 shadow-xs space-y-5"}>
        <h2 class="font-serif text-xl font-bold text-emerald-950 pb-3 border-b border-slate-200">
          1. Select Formulation Parameters
        </h2>

        <div>
          <label for="b-humic" class="block text-sm font-semibold text-slate-800 mb-1.5">
            Humic / Fulvic Base Source
          </label>
          <select id="b-humic" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-800 focus:bg-white focus:outline-none">
            <option value="potassium_humate">Potassium Humate (70–80% HA, Alkaline)</option>
            <option value="potassium_fulvate">Acid-Soluble Potassium Fulvate (ISO 19822 DAX-8)</option>
          </select>
        </div>

        <div>
          <label for="b-partner" class="block text-sm font-semibold text-slate-800 mb-1.5">
            Partner Biostimulant / Additive
          </label>
          <select id="b-partner" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-800 focus:bg-white focus:outline-none">
            <option value="alkaline_seaweed">Alkaline Seaweed Extract (Ascophyllum nodosum)</option>
            <option value="enzymatic_amino">Neutral Enzymatic L-Amino Acid (pH 5.8–7.0)</option>
            <option value="acidic_amino">Acidic Hydrolyzed Amino Acid (pH &lt; 4.5, High Salt)</option>
            <option value="micro_sulfates">Micronutrient Sulfates (FeSO₄ / ZnSO₄ / MnSO₄ / MgSO₄)</option>
          </select>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="b-ph" class="text-sm font-semibold text-slate-800">
              Target Tank / Bottle pH
            </label>
            <span id="b-ph-readout" class="inline-flex items-center rounded-lg bg-emerald-950 px-2.5 py-0.5 text-sm font-bold text-amber-400">
              pH 8.0
            </span>
          </div>
          <input
            id="b-ph"
            type="range"
            min="3.0"
            max="10.0"
            step="0.1"
            value="8.0"
            class="w-full accent-emerald-900 cursor-pointer"
          />
          <div class="flex justify-between text-[11px] font-medium text-slate-500 mt-1">
            <span>3.0 (Strong Acid)</span>
            <span class="text-red-700 font-bold">4.5–5.0 Crash</span>
            <span>7.0 (Neutral)</span>
            <span>10.0 (Alkaline)</span>
          </div>
        </div>

        <div>
          <label for="b-water" class="block text-sm font-semibold text-slate-800 mb-1.5">
            Process / Dilution Water Hardness
          </label>
          <select id="b-water" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-emerald-800 focus:bg-white focus:outline-none">
            <option value="soft">Soft / RO / Deionized Water (&lt; 100 ppm CaCO₃)</option>
            <option value="hard">Hard Borewell / Tap Water (&gt; 300 ppm CaCO₃)</option>
          </select>
        </div>
      </section>

      <!-- Live Stability Verdict -->
      <section aria-live="polite" aria-label="Formulation Stability Verdict" class={isEmbed ? "md:col-span-6 rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-sm" : "lg:col-span-6 rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-sm"}>
        <div id="b-banner" class="px-6 py-5 bg-emerald-800 text-white transition-colors">
          <div class="flex items-center justify-between gap-2">
            <span id="b-pill" class="inline-flex rounded-full bg-white/20 px-3 py-1 text-xs font-extrabold uppercase tracking-wider">
              GREEN — STABLE FORMULATION
            </span>
            <span id="b-ph-tag" class="text-xs font-semibold text-white/90">Target pH 8.0</span>
          </div>
          <h2 id="b-headline" class="font-serif text-2xl font-bold mt-2 text-white">
            —
          </h2>
        </div>

        <div class="p-6 space-y-4">
          <div class="grid grid-cols-2 gap-3 text-center">
            <div class="rounded-xl bg-slate-50 border border-slate-200 p-3">
              <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Precipitation Risk</div>
              <div id="b-precip" class="font-serif text-lg font-bold mt-0.5">—</div>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-200 p-3">
              <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Gelation / Sediment</div>
              <div id="b-gel" class="font-serif text-lg font-bold mt-0.5">—</div>
            </div>
          </div>

          <div class="rounded-xl bg-slate-50 border border-slate-200 p-4 space-y-1.5">
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-emerald-900">Chemical Mechanism</h3>
            <p id="b-mech" class="text-sm text-slate-700 leading-relaxed m-0">—</p>
          </div>

          <div class="rounded-xl bg-amber-50 border border-amber-200 p-4 space-y-1.5">
            <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-amber-900">Recommended Corrective Action</h3>
            <p id="b-action" class="text-sm text-amber-950 leading-relaxed m-0">—</p>
          </div>

          <div class="pt-3 border-t border-slate-200 flex flex-wrap gap-3">
            <a href="/synergies/manufacturer-liquid-formulation-stability" target={linkTarget} rel={linkRel} class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2">
              Manufacturer Formulation Guide &rarr;
            </a>
            <a href="/manufacturing/solving-the-ph-conflict-humate-vs-fulvate" target={linkTarget} rel={linkRel} class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2">
              Humate vs. Fulvate pH Playbook &rarr;
            </a>
          </div>
        </div>
      </section>
    </div>
</div>

  <script is:inline>
    (function () {
      const elHumic = document.getElementById('b-humic');
      const elPartner = document.getElementById('b-partner');
      const elPh = document.getElementById('b-ph');
      const elPhReadout = document.getElementById('b-ph-readout');
      const elWater = document.getElementById('b-water');

      const banner = document.getElementById('b-banner');
      const pill = document.getElementById('b-pill');
      const phTag = document.getElementById('b-ph-tag');
      const headline = document.getElementById('b-headline');
      const precipEl = document.getElementById('b-precip');
      const gelEl = document.getElementById('b-gel');
      const mechEl = document.getElementById('b-mech');
      const actionEl = document.getElementById('b-action');

      let trackTimer = null;
      function track(detail) {
        clearTimeout(trackTimer);
        trackTimer = setTimeout(function () {
          window.dataLayer = window.dataLayer || [];
          var _root = document.querySelector('[data-humic-widget="blend-ph-estimator"]');
          var _payload = {
            event: 'humic_tool_interaction',
            tool_name: 'blend_ph_estimator',
            action_detail: detail,
          };
          if (_root && _root.getAttribute('data-is-embed') === 'true') {
            _payload.is_embed = true;
          }
          window.dataLayer.push(_payload);
        }, 450);
      }

      function evaluate(shouldTrack) {
        const humic = elHumic.value;
        const partner = elPartner.value;
        const ph = parseFloat(elPh.value);
        const water = elWater.value;

        elPhReadout.textContent = 'pH ' + ph.toFixed(1);
        phTag.textContent = 'Target pH ' + ph.toFixed(1);

        let verdict = 'green';
        let head = '';
        let precip = 'Low';
        let gel = 'Low';
        let mech = '';
        let action = '';

        if (humic === 'potassium_humate') {
          if (ph < 5.0) {
            verdict = 'red';
            precip = 'SEVERE';
            gel = 'HIGH';
            head = 'Immediate Acid Precipitation Crash (< pH 5.0)';
            mech = 'Below pH 4.5–5.0, potassium humate carboxylates protonate into insoluble humic acid (–COOH), collapsing colloidal charge and precipitating dense black sludge regardless of partner.';
            action = 'Switch your humic base to Acid-Soluble Potassium Fulvate for acidic pH 3.5–5.5 formulas, OR buffer target pH upward to ≥ 7.5 with KOH (only if partner is alkaline seaweed or neutral enzymatic L-amino).';
          } else if (partner === 'micro_sulfates') {
            verdict = 'red';
            precip = 'SEVERE';
            gel = 'HIGH';
            head = 'Incompatible — Divalent Cation Bridging & Metal Hydroxide Crash';
            mech = 'Unchelated Fe/Zn/Mn/Mg sulfates cross-link potassium humate polymers via divalent bridging and precipitate as rusty/grey metal hydroxides above pH 6.8–7.5.';
            action = 'Replace raw metal sulfates with fully chelated EDTA/EDDHA/DTPA micronutrients (keeping target pH 7.5–8.5), OR switch base to Acid-Soluble Potassium Fulvate at pH 4.0–5.0.';
          } else if (water === 'hard' && ph >= 5.0) {
            verdict = 'red';
            precip = 'HIGH';
            gel = 'HIGH';
            head = 'Hard-Water Flocculation & Sedimentation Failure (>300 ppm CaCO₃)';
            mech = 'Dissolved Ca²⁺ and Mg²⁺ in hard factory water (>300 ppm) displace K⁺ and bridge potassium humate colloids into gritty bottom cake during warehouse storage.';
            action = 'Manufacture liquid concentrates strictly with RO or deionized water (<50 µS/cm) plus 0.3%–0.5% tripotassium citrate, OR switch base to Acid-Soluble Potassium Fulvate.';
          } else if (partner === 'acidic_amino') {
            verdict = ph < 6.5 ? 'red' : 'amber';
            precip = ph < 6.5 ? 'HIGH' : 'Moderate';
            gel = 'HIGH';
            head = ph < 6.5 ? 'Acidic Hydrolysate Salt-Out & Precipitation Crash' : 'High Gelation Risk — Salt Load From Acid-Hydrolyzed Aminos';
            mech = 'Acid-hydrolyzed proteins (pH < 4.5) carry 8%–15% NaCl/chloride salt loads that compress the humic electrical double layer, causing delayed thixotropic gelation and cold-storage settling even if buffered upward.';
            action = 'Switch to low-salt neutral enzymatic plant L-amino acids (pH 5.8–7.0) and buffer ≥ pH 7.5, OR reformulate around Acid-Soluble Potassium Fulvate at pH 4.5–5.0.';
          } else if (ph < 6.5) {
            verdict = 'amber';
            precip = 'Moderate';
            gel = 'Moderate';
            head = 'Narrow Safety Margin — Risk of Delayed Thickening (pH 5.0–6.4)';
            mech = 'Potassium humate zeta potential declines below pH 6.5. Minor CO₂ absorption or warehouse temperature swings can nudge pH below 5.5 and cause irreversible thickening.';
            action = 'Buffer concentrate upward to pH 7.5–9.0 using dilute KOH, validate with 14-day CIPAC 54 °C aging, and use vented ePTFE induction liners to manage microbial gas.';
          } else {
            verdict = 'green';
            precip = 'Low';
            gel = 'Low';
            head = 'Stable Alkaline Colloidal Window for Pilot Batching';
            mech = 'Target pH (' + ph.toFixed(1) + ') in soft RO water preserves strong negative zeta potential on potassium humate alongside compatible alkaline kelp or neutral enzymatic L-amino acids.';
            action = 'Keep total dissolved solids ≤ 22–24% w/v, polish-filter to 5–10 µm, match alkaline-active preservation (note: sorbate/benzoate fail > pH 5.8), and cap with vented ePTFE liners.';
          }
        } else {
          // Acid-Soluble Potassium Fulvate
          if (partner === 'micro_sulfates' && ph > 6.8) {
            verdict = 'red';
            precip = 'HIGH';
            gel = 'Moderate';
            head = 'Alkaline Metal Hydroxide Precipitation (> pH 6.8)';
            mech = 'While Potassium Fulvate stays soluble up to pH 14, unchelated Fe/Zn/Mn sulfates hydrolyze out of solution as insoluble metal hydroxides once bottle pH rises above 6.8–7.2.';
            action = 'Lower target bottle pH cleanly into the pH 4.0–5.2 window where both Potassium Fulvate and trace metal sulfates stay crystal clear, OR switch to EDTA/EDDHA chelates.';
          } else if (partner === 'alkaline_seaweed' && ph < 4.0) {
            verdict = 'amber';
            precip = 'Moderate';
            gel = 'Moderate';
            head = 'Alginic Acid Thickening Caution (< pH 4.0)';
            mech = 'Alkaline-extracted Ascophyllum nodosum contains soluble alginates that protonate into viscous alginic acid gels below pH 3.8–4.0 even though Potassium Fulvate itself stays dissolved.';
            action = 'Hold finished concentrate pH between 4.5 and 5.5 (ideal window for sorbate/benzoate preservation) or switch to cold-pressed acid-stabilized kelp.';
          } else {
            verdict = 'green';
            precip = 'Low';
            gel = 'Low';
            head = 'High Stability — Acid-Soluble Potassium Fulvate Window';
            mech = 'True ISO 19822 DAX-8 Potassium Fulvate remains completely clear across acidic pH and hard water (>300 ppm CaCO₃), chelating divalent cations without flocculating.';
            action = 'Verify mineral leonardite origin (avoid molasses-derived biochemical fulvate that ferments/bloats bottles). At pH 4.5–5.2, food-grade potassium sorbate + sodium benzoate work at peak efficacy.';
          }
        }

        const bannerCls = {
          red: 'px-6 py-5 bg-red-700 text-white transition-colors',
          amber: 'px-6 py-5 bg-amber-600 text-white transition-colors',
          green: 'px-6 py-5 bg-emerald-800 text-white transition-colors',
        };
        const pillText = {
          red: 'RED — FORMULATION CRASH RISK',
          amber: 'AMBER — CONDITIONAL STABILITY',
          green: 'GREEN — STABLE FORMULATION WINDOW',
        };
        const badgeColor = function (val) {
          if (val === 'SEVERE' || val === 'HIGH') return 'font-serif text-lg font-bold mt-0.5 text-red-700';
          if (val === 'Moderate') return 'font-serif text-lg font-bold mt-0.5 text-amber-600';
          return 'font-serif text-lg font-bold mt-0.5 text-emerald-800';
        };

        banner.className = bannerCls[verdict];
        pill.textContent = pillText[verdict];
        headline.textContent = head;
        precipEl.textContent = precip;
        precipEl.className = badgeColor(precip);
        gelEl.textContent = gel;
        gelEl.className = badgeColor(gel);
        mechEl.textContent = mech;
        actionEl.textContent = action;

        if (shouldTrack) {
          track(humic + '+' + partner + ':pH' + ph.toFixed(1) + ':' + water + '->' + verdict);
        }
      }

      [elHumic, elPartner, elPh, elWater].forEach(function (el) {
        el.addEventListener('input', function () { evaluate(true); });
        el.addEventListener('change', function () { evaluate(true); });
      });

      evaluate(false);
    })();
  </script>
