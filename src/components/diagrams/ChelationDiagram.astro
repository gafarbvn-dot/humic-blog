---
export interface Props {
  caption?: string;
}
const {
  caption = 'Figure: Contrast between soluble micronutrient chelation (left, where carboxyl/phenolic ligands shield Fe/Zn in solution) and divalent calcium cross-linking flocculation (right, where Ca²⁺ bridges potassium humate assemblies into insoluble precipitates).',
} = Astro.props;
---

<figure class="my-8 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:p-6 not-prose">
  <div class="mb-3 flex items-center justify-between gap-2">
    <span class="text-xs font-bold uppercase tracking-wider text-emerald-900">
      Scientific Diagram &bull; Chelation vs. Divalent Flocculation
    </span>
    <span class="rounded-full bg-amber-500/15 border border-amber-500/30 px-2.5 py-0.5 text-[11px] font-semibold text-amber-900">
      Tank-Mix &amp; Rhizosphere Chemistry
    </span>
  </div>
  <svg viewBox="0 0 760 250" class="w-full h-auto" role="img" aria-label="Comparison of soluble micronutrient chelation versus calcium-induced humic flocculation">
    <rect x="0" y="0" width="760" height="250" rx="12" fill="#ffffff" stroke="#e2e8f0"/>
    <!-- Left panel: Chelation -->
    <rect x="20" y="20" width="348" height="210" rx="10" fill="#ecfdf5" stroke="#059669" stroke-width="1.5"/>
    <text x="194" y="45" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#065f46">SOLUBLE CHELATION (FULVIC / DILUTE HUMIC)</text>
    <!-- Aromatic ring -->
    <polygon points="105,98 135,82 165,98 165,132 135,148 105,132" fill="#ffffff" stroke="#065f46" stroke-width="2.5"/>
    <text x="135" y="119" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" font-weight="700" fill="#065f46">Ring</text>
    <!-- Ligands -->
    <line x1="165" y1="98" x2="208" y2="92" stroke="#065f46" stroke-width="2"/>
    <text x="214" y="96" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#065f46">–COO⁻</text>
    <line x1="165" y1="132" x2="208" y2="138" stroke="#065f46" stroke-width="2"/>
    <text x="214" y="142" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#065f46">–O⁻</text>
    <!-- Coordinate dashed bonds to Metal -->
    <line x1="256" y1="96" x2="282" y2="112" stroke="#d97706" stroke-width="2.5" stroke-dasharray="4,3"/>
    <line x1="242" y1="136" x2="282" y2="122" stroke="#d97706" stroke-width="2.5" stroke-dasharray="4,3"/>
    <circle cx="298" cy="117" r="22" fill="#f59e0b"/>
    <text x="298" y="115" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#022c22">Fe²⁺</text>
    <text x="298" y="128" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" font-weight="700" fill="#022c22">Zn²⁺</text>
    <text x="194" y="188" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#064e3b">Inner-sphere ring shields trace metals</text>
    <text x="194" y="205" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#064e3b">from high-pH carbonate precipitation.</text>

    <!-- Right panel: Divalent Bridging Flocculation -->
    <rect x="392" y="20" width="348" height="210" rx="10" fill="#fef2f2" stroke="#dc2626" stroke-width="1.5"/>
    <text x="566" y="45" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#991b1b">DIVALENT BRIDGING (Ca²⁺ FLOCCULATION)</text>
    <!-- Humate assembly 1 -->
    <rect x="418" y="88" width="96" height="54" rx="12" fill="#022c22"/>
    <text x="466" y="112" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#ffffff">Humate A</text>
    <text x="466" y="128" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#fbbf24">–COO⁻</text>
    <!-- Ca2+ Bridge -->
    <line x1="514" y1="115" x2="544" y2="115" stroke="#dc2626" stroke-width="3"/>
    <circle cx="566" cy="115" r="22" fill="#dc2626"/>
    <text x="566" y="119" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#ffffff">Ca²⁺</text>
    <line x1="588" y1="115" x2="618" y2="115" stroke="#dc2626" stroke-width="3"/>
    <!-- Humate assembly 2 -->
    <rect x="618" y="88" width="96" height="54" rx="12" fill="#022c22"/>
    <text x="666" y="112" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#ffffff">Humate B</text>
    <text x="666" y="128" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#fbbf24">–COO⁻</text>
    <text x="566" y="188" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#7f1d1d">Divalent Ca²⁺ displaces K⁺ &amp; cross-links</text>
    <text x="566" y="205" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#7f1d1d">polymers &rarr; insoluble emitter-clogging sludge.</text>
  </svg>
  <figcaption class="mt-3 text-xs text-slate-600 leading-relaxed">{caption}</figcaption>
</figure>
