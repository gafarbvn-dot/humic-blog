---
export interface Props {
  caption?: string;
}
const {
  caption = 'Figure: Operational aqueous solubility across pH 1–14 for Fulvic Acid, Humic Acid, and Humin (IHSS & ISO 19822 basis). Humic acid precipitates as protonated sludge below pH 4.5–5.0.',
} = Astro.props;
---

<figure class="my-8 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:p-6 not-prose">
  <div class="mb-3 flex items-center justify-between gap-2">
    <span class="text-xs font-bold uppercase tracking-wider text-emerald-900">
      Scientific Diagram &bull; pH Solubility Spectrum
    </span>
    <span class="rounded-full bg-amber-500/15 border border-amber-500/30 px-2.5 py-0.5 text-[11px] font-semibold text-amber-900">
      pH 1 &ndash; 14
    </span>
  </div>
  <svg viewBox="0 0 760 280" class="w-full h-auto" role="img" aria-label="pH solubility curves for fulvic acid, humic acid, and humin">
    <rect x="0" y="0" width="760" height="280" rx="12" fill="#ffffff" stroke="#e2e8f0"/>
    <!-- Crash zone highlight (pH 1 to 5) -->
    <rect x="70" y="34" width="205" height="182" fill="#fef2f2"/>
    <text x="172" y="52" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#b91c1c">ACID PRECIPITATION ZONE (pH &lt; 4.5–5.0)</text>
    <!-- Neutral/Alkaline zone -->
    <rect x="275" y="34" width="445" height="182" fill="#f0fdf4" fill-opacity="0.55"/>
    <text x="498" y="52" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#065f46">STABLE COLLOIDAL SOLUTION ZONE (pH 5.5–11+)</text>
    <!-- Gridlines -->
    <line x1="70" y1="216" x2="720" y2="216" stroke="#64748b" stroke-width="1.5"/>
    <line x1="70" y1="34" x2="70" y2="216" stroke="#64748b" stroke-width="1.5"/>
    <line x1="275" y1="34" x2="275" y2="216" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5,4"/>
    <!-- Y-axis labels -->
    <text x="58" y="84" text-anchor="end" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="#334155">100%</text>
    <text x="58" y="148" text-anchor="end" font-family="system-ui, sans-serif" font-size="11" fill="#64748b">50%</text>
    <text x="58" y="214" text-anchor="end" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="#334155">0%</text>
    <text x="20" y="128" text-anchor="middle" transform="rotate(-90 20 128)" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#0f172a">Solubility</text>
    <!-- X-axis ticks (pH 1 to 14) -->
    <g font-family="system-ui, sans-serif" font-size="11" fill="#475569" text-anchor="middle">
      <text x="70" y="236">pH 1</text>
      <text x="170" y="236">pH 3</text>
      <text x="275" y="236" font-weight="700" fill="#b91c1c">pH 5</text>
      <text x="370" y="236">pH 7</text>
      <text x="470" y="236">pH 9</text>
      <text x="570" y="236">pH 11</text>
      <text x="710" y="236">pH 14</text>
    </g>
    <!-- Fulvic Acid Curve (always ~100% soluble) -->
    <path d="M 70 80 L 715 80" fill="none" stroke="#d97706" stroke-width="4" stroke-linecap="round"/>
    <rect x="440" y="64" width="245" height="22" rx="6" fill="#fffbeb" stroke="#f59e0b"/>
    <text x="562" y="79" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#92400e">Fulvic Acid (Soluble Across pH 1–14)</text>
    <!-- Humic Acid Curve (precipitates < pH 4.5-5.0, soluble above) -->
    <path d="M 70 208 L 210 206 C 250 204, 265 110, 315 98 L 715 96" fill="none" stroke="#065f46" stroke-width="4" stroke-linecap="round"/>
    <rect x="405" y="106" width="285" height="22" rx="6" fill="#ecfdf5" stroke="#059669"/>
    <text x="547" y="121" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#064e3b">Humic Acid / K-Humate (Precipitates &lt; pH 4.5)</text>
    <!-- Humin Curve (insoluble across all pH) -->
    <path d="M 70 212 L 715 212" fill="none" stroke="#334155" stroke-width="3.5" stroke-dasharray="8,5"/>
    <rect x="445" y="182" width="240" height="22" rx="6" fill="#f1f5f9" stroke="#64748b"/>
    <text x="565" y="197" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#334155">Humin (Insoluble at All pH Values)</text>
  </svg>
  <figcaption class="mt-3 text-xs text-slate-600 leading-relaxed">{caption}</figcaption>
</figure>
