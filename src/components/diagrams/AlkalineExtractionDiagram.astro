---
export interface Props {
  caption?: string;
}
const {
  caption = 'Figure: Industrial alkaline extraction of geological leonardite comparing KOH (agronomically beneficial Potassium Humate) versus NaOH (clay-dispersing industrial Sodium Humate).',
} = Astro.props;
---

<figure class="my-8 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:p-6 not-prose">
  <div class="mb-3 flex items-center justify-between gap-2">
    <span class="text-xs font-bold uppercase tracking-wider text-emerald-900">
      Scientific Diagram &bull; Alkaline Extraction &amp; Cation Impact
    </span>
    <span class="rounded-full bg-emerald-900/10 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-900">
      KOH vs. NaOH
    </span>
  </div>
  <svg viewBox="0 0 760 270" class="w-full h-auto" role="img" aria-label="Leonardite alkaline extraction workflow comparing potassium hydroxide and sodium hydroxide">
    <rect x="0" y="0" width="760" height="270" rx="12" fill="#ffffff" stroke="#e2e8f0"/>
    <!-- Stage 1: Raw Leonardite -->
    <rect x="24" y="92" width="150" height="86" rx="10" fill="#022c22"/>
    <text x="99" y="124" text-anchor="middle" font-family="Georgia, serif" font-size="14" font-weight="bold" fill="#fbbf24">Raw Leonardite</text>
    <text x="99" y="145" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#d1fae5">40–85% Humic Acid</text>
    <text x="99" y="162" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#a7f3d0">(Insoluble –COOH)</text>
    <!-- Arrows splitting -->
    <path d="M 174 120 L 236 74" fill="none" stroke="#059669" stroke-width="3" marker-end="url(#arrow-green)"/>
    <path d="M 174 150 L 236 196" fill="none" stroke="#dc2626" stroke-width="3" marker-end="url(#arrow-red)"/>
    <defs>
      <marker id="arrow-green" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#059669"/></marker>
      <marker id="arrow-red" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#dc2626"/></marker>
    </defs>
    <!-- Top Branch: KOH -->
    <rect x="244" y="28" width="195" height="90" rx="10" fill="#ecfdf5" stroke="#059669" stroke-width="2"/>
    <text x="341" y="54" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#065f46">+ Potassium Hydroxide (KOH)</text>
    <text x="341" y="75" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#1e293b">Centrifuge removes ash &amp; humin</text>
    <text x="341" y="96" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#047857">&rarr; Potassium Humate (–COO⁻ K⁺)</text>

    <path d="M 439 73 L 492 73" fill="none" stroke="#059669" stroke-width="3" marker-end="url(#arrow-green)"/>
    <rect x="500" y="28" width="236" height="90" rx="10" fill="#064e3b"/>
    <text x="618" y="53" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#fbbf24">AGRONOMIC GRADE (SAFE)</text>
    <text x="618" y="75" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#ffffff">&bull; Supplies 8–12% plant-available K₂O</text>
    <text x="618" y="95" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#d1fae5">&bull; Preserves clay flocculation &amp; pores</text>

    <!-- Bottom Branch: NaOH -->
    <rect x="244" y="152" width="195" height="90" rx="10" fill="#fef2f2" stroke="#dc2626" stroke-width="2"/>
    <text x="341" y="178" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#991b1b">+ Sodium Hydroxide (NaOH)</text>
    <text x="341" y="199" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#1e293b">Lower cost caustic soda digestion</text>
    <text x="341" y="220" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#b91c1c">&rarr; Sodium Humate (–COO⁻ Na⁺)</text>

    <path d="M 439 197 L 492 197" fill="none" stroke="#dc2626" stroke-width="3" marker-end="url(#arrow-red)"/>
    <rect x="500" y="152" width="236" height="90" rx="10" fill="#7f1d1d"/>
    <text x="618" y="177" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#fde68a">INDUSTRIAL GRADE (SOIL RISK)</text>
    <text x="618" y="199" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#ffffff">&bull; Adds 6–10% exchangeable Na⁺</text>
    <text x="618" y="219" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" fill="#fecaca">&bull; Disperses clay &amp; seals soil surface</text>
  </svg>
  <figcaption class="mt-3 text-xs text-slate-600 leading-relaxed">{caption}</figcaption>
</figure>
