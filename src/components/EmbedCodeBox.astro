---
export interface Props {
  slug: string;
  toolTitle: string;
  iframeHeight?: number;
  defaultOpen?: boolean;
}

const { slug, toolTitle, iframeHeight = 680, defaultOpen = false } = Astro.props;
const siteOrigin = 'https://humic.blog';
const embedUrl = `${siteOrigin}/embed/${slug}`;
const fullUrl = `${siteOrigin}/tools/${slug}`;
const snippet = `<iframe src="${embedUrl}" title="${toolTitle} — Humic.blog" width="100%" height="${iframeHeight}" style="width:100%;max-width:800px;min-height:${iframeHeight}px;border:0;border-radius:16px;overflow:hidden;" loading="lazy"></iframe>\n<p style="font-size:12px;color:#475569;margin-top:6px;">Powered by <a href="${fullUrl}" target="_blank" rel="noopener">humic.blog — ${toolTitle}</a></p>`;
const boxId = `embed-box-${slug}`;
---

<section
  aria-label={`Embed ${toolTitle}`}
  class="rounded-2xl bg-white border border-slate-200 shadow-xs overflow-hidden"
>
  <details open={defaultOpen} class="group">
    <summary class="list-none cursor-pointer px-6 py-4 bg-slate-50 hover:bg-emerald-50/50 transition-colors flex items-center justify-between gap-4 border-b border-transparent group-open:border-slate-200">
      <div class="flex items-center gap-3 min-w-0">
        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-950 text-amber-400 font-mono text-xs font-bold">
          &lt;/&gt;
        </span>
        <div>
          <h2 class="font-serif text-base sm:text-lg font-bold text-emerald-950 m-0 leading-snug">
            Free to Embed on Your Website or Agronomy Blog
          </h2>
          <p class="text-xs text-slate-600 m-0 mt-0.5">
            Copy the responsive iframe snippet below &mdash; free for universities, dealers, and agronomy portals with attribution intact.
          </p>
        </div>
      </div>
      <span class="shrink-0 inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-emerald-900 group-open:bg-emerald-950 group-open:text-white group-open:border-emerald-950 transition-colors">
        <span class="group-open:hidden">Get Code</span>
        <span class="hidden group-open:inline">Hide Code</span>
      </span>
    </summary>

    <div class="p-6 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <label for={`${boxId}-code`} class="text-xs font-bold uppercase tracking-wider text-slate-500">
          Responsive HTML Embed Snippet ({toolTitle})
        </label>
        <div class="flex items-center gap-2">
          <a
            href={`/embed/${slug}`}
            target="_blank"
            rel="noopener"
            class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2"
          >
            Preview Widget &#8599;
          </a>
          <button
            type="button"
            data-copy-target={`${boxId}-code`}
            data-tool-slug={slug}
            class="embed-copy-btn inline-flex items-center gap-1.5 rounded-lg bg-emerald-900 hover:bg-emerald-950 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs transition-colors cursor-pointer"
          >
            Copy Embed Code
          </button>
        </div>
      </div>

      <textarea
        id={`${boxId}-code`}
        readonly
        rows="4"
        spellcheck="false"
        class="w-full rounded-xl border border-slate-300 bg-slate-950 text-emerald-100 font-mono text-xs leading-relaxed p-3.5 focus:outline-none focus:ring-2 focus:ring-amber-500"
      >{snippet}</textarea>

      <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600">
        <span>Works responsively from <strong>320px to 800px</strong> width. Zero API keys, zero tracking cookies, zero vendor branding.</span>
        <a href="/tools/embed" class="font-semibold text-emerald-800 hover:text-emerald-950 underline decoration-amber-500 underline-offset-2">
          Browse all 4 embeddable widgets &rarr;
        </a>
      </div>
    </div>
  </details>
</section>

<script is:inline>
  (function () {
    if (window.__humicEmbedCopyInit) return;
    window.__humicEmbedCopyInit = true;

    document.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest ? e.target.closest('.embed-copy-btn') : null;
      if (!btn) return;
      var targetId = btn.getAttribute('data-copy-target');
      var slug = btn.getAttribute('data-tool-slug') || '';
      var ta = document.getElementById(targetId);
      if (!ta) return;

      var text = ta.value;
      var finish = function () {
        var orig = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.remove('bg-emerald-900', 'hover:bg-emerald-950');
        btn.classList.add('bg-amber-500', 'text-emerald-950');
        setTimeout(function () {
          btn.textContent = orig;
          btn.classList.remove('bg-amber-500', 'text-emerald-950');
          btn.classList.add('bg-emerald-900', 'hover:bg-emerald-950');
        }, 2000);

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'humic_tool_embed_copy',
          tool_name: slug,
        });
      };

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(finish).catch(function () {
          ta.focus();
          ta.select();
          finish();
        });
      } else {
        ta.focus();
        ta.select();
        finish();
      }
    });
  })();
</script>
